 create mode 100644 vanadium/chromium_src/android_webview/renderer/renderer_cc_ext_deps.gni
 create mode 100644 vanadium/chromium_src/android_webview/renderer/renderer_cc_ext_sources.gni

diff --git a/android_webview/renderer/BUILD.gn b/android_webview/renderer/BUILD.gn
index acfbb9918e452..e21462642879a 100644
--- a/android_webview/renderer/BUILD.gn
+++ b/android_webview/renderer/BUILD.gn
@@ -67,4 +67,9 @@ source_set("renderer") {
       "//components/printing/renderer",
     ]
   }
+
+ import("//vanadium/chromium_src/android_webview/renderer/renderer_cc_ext_sources.gni")
+ sources += renderer_cc_ext_sources
+ import("//vanadium/chromium_src/android_webview/renderer/renderer_cc_ext_deps.gni")
+ deps += renderer_cc_ext_deps
 }
diff --git a/vanadium/chromium_src/android_webview/renderer/renderer_cc_ext_deps.gni b/vanadium/chromium_src/android_webview/renderer/renderer_cc_ext_deps.gni
new file mode 100644
