Subject: [PATCH] Extend //chrome/android java targets sources and deps

---
 chrome/android/BUILD.gn                       | 11 ++++++++
 .../chrome_app_java_resources_ext_sources.gni | 26 +++++++++++++++++++
 .../chrome/android/chrome_java_ext_deps.gni   | 26 +++++++++++++++++++
 .../android/chrome_java_ext_sources.gni       | 26 +++++++++++++++++++
 .../android/chrome_java_ext_srcjar_deps.gni   | 26 +++++++++++++++++++
 5 files changed, 115 insertions(+)
 create mode 100644 vanadium/chromium_src/chrome/android/chrome_app_java_resources_ext_sources.gni
 create mode 100644 vanadium/chromium_src/chrome/android/chrome_java_ext_deps.gni
 create mode 100644 vanadium/chromium_src/chrome/android/chrome_java_ext_sources.gni
 create mode 100644 vanadium/chromium_src/chrome/android/chrome_java_ext_srcjar_deps.gni

diff --git a/chrome/android/BUILD.gn b/chrome/android/BUILD.gn
index 1f44f11e6bf18..b337a1c20b307 100644
--- a/chrome/android/BUILD.gn
+++ b/chrome/android/BUILD.gn
@@ -168,6 +168,9 @@ if (_is_default_toolchain) {
 
   android_resources("chrome_app_java_resources") {
     sources = chrome_java_resources
+    # Extension of sources at chrome_app_java_resources
+    import("//vanadium/chromium_src/chrome/android/chrome_app_java_resources_ext_sources.gni")
+    sources += chrome_app_java_resources_ext_sources
     sources += [
       "//chrome/android/java/res_app/layout/main.xml",
       "//chrome/android/java/res_app/layout/main_forked_with_secondary_ui_container.xml",
@@ -886,6 +889,14 @@ if (_is_default_toolchain) {
     # From java_sources.gni.
     sources = chrome_java_sources
 
+    # Extension of sources, deps, and srcjar_deps for chrome_java target
+    import("//vanadium/chromium_src/chrome/android/chrome_java_ext_sources.gni")
+    sources += chrome_java_ext_sources
+    import("//vanadium/chromium_src/chrome/android/chrome_java_ext_deps.gni")
+    deps += chrome_java_ext_deps
+    import("//vanadium/chromium_src/chrome/android/chrome_java_ext_srcjar_deps.gni")
+    srcjar_deps += chrome_java_ext_srcjar_deps
+
     # Include sources from feed_java_sources.gni.
     sources += feed_java_sources
     srcjar_deps += feed_srcjar_deps
