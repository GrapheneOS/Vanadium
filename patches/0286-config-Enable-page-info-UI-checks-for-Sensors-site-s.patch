From: quh4gko8 <88831734+quh4gko8@users.noreply.github.com>
Date: Wed, 20 May 2026 15:28:33 +0000
Subject: [PATCH] [config] Enable page info UI checks for Sensors site settings

---
 .../src/app/vanadium/config/host/ConfigGenerator.java | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/vanadium/android_config/proto/host/java/src/app/vanadium/config/host/ConfigGenerator.java b/vanadium/android_config/proto/host/java/src/app/vanadium/config/host/ConfigGenerator.java
index c75888b67b7a6..c98cd2a675a6d 100644
--- a/vanadium/android_config/proto/host/java/src/app/vanadium/config/host/ConfigGenerator.java
+++ b/vanadium/android_config/proto/host/java/src/app/vanadium/config/host/ConfigGenerator.java
@@ -254,6 +254,17 @@ public class ConfigGenerator {
                         )
                 ))
         ));
+        configList.add(config(configParams -> configParams.setSpec(
+                        spec(specParams -> specParams.setSpecTypes(
+                                getSpecTypes(SpecType.BROWSER))
+                                .setMinVersion(7827_022_00L)
+                        ))
+                .addAllFlags(flags(
+                        flag(flagParams -> flagParams.setFlagName("CheckOSPermissionForSensorsSiteSettingsPermission")
+                                .setFlagType(FlagType.ENABLED_FEATURE)
+                        )
+                ))
+        ));
         return sortConfigs(configList);
     }
 
