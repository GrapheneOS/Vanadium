From: quh4gko8 <88831734+quh4gko8@users.noreply.github.com>
Date: Tue, 7 Jul 2026 10:58:14 +0000
Subject: [PATCH] [tmp] Use CHECK insted of DCHECK based on recent crashes at
 simple_entry_impl.cc

---
 net/disk_cache/simple/simple_entry_impl.cc | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/net/disk_cache/simple/simple_entry_impl.cc b/net/disk_cache/simple/simple_entry_impl.cc
index 22715f3e2dd71..6cdf754029e89 100644
--- a/net/disk_cache/simple/simple_entry_impl.cc
+++ b/net/disk_cache/simple/simple_entry_impl.cc
@@ -366,13 +366,13 @@ void SimpleEntryImpl::Close() {
   net_log_.AddEvent(net::NetLogEventType::SIMPLE_CACHE_ENTRY_CLOSE_CALL);
 
   if (--open_count_ > 0) {
-    DCHECK(!HasOneRef());
+    CHECK(!HasOneRef());
     Release();  // Balanced in ReturnEntryToCaller().
     return;
   }
 
   pending_operations_.push(SimpleEntryOperation::CloseOperation(this));
-  DCHECK(!HasOneRef());
+  CHECK(!HasOneRef());
   Release();  // Balanced in ReturnEntryToCaller().
   RunNextOperationIfNeeded();
 }
