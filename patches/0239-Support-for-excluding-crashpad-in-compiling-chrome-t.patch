From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: quh4gko8 <88831734+quh4gko8@users.noreply.github.com>
Date: Wed, 26 Feb 2025 09:46:02 +0000
Subject: [PATCH] Support for excluding crashpad in compiling chrome targets

---
 chrome/android/chrome_public_apk_tmpl.gni                | 4 ++++
 chrome/android/trichrome.gni                             | 5 +++++
 vanadium/chromium_src/chrome/android/chrome_ext_args.gni | 1 +
 3 files changed, 10 insertions(+)

diff --git a/chrome/android/chrome_public_apk_tmpl.gni b/chrome/android/chrome_public_apk_tmpl.gni
index f1da20da2015e..d8a2fdc6062b8 100644
--- a/chrome/android/chrome_public_apk_tmpl.gni
+++ b/chrome/android/chrome_public_apk_tmpl.gni
@@ -585,6 +585,10 @@ template("chrome_common_apk_or_module_tmpl") {
       library_always_compress = invoker.library_always_compress
     }
 
+    import("//vanadium/chromium_src/chrome/android/chrome_ext_args.gni")
+    if (!include_crashpad) {
+      # Empty loadable module for now until stub crashpad shared object is needed.
+    } else
     if (!_is_trichrome) {
       # https://chromium.googlesource.com/chromium/src/+/main/docs/android_native_libraries.md#Crashpad-Packaging
       deps += [
diff --git a/chrome/android/trichrome.gni b/chrome/android/trichrome.gni
index a77c190388409..a64ce2a00136b 100644
--- a/chrome/android/trichrome.gni
+++ b/chrome/android/trichrome.gni
@@ -153,6 +153,11 @@ template("trichrome_library_apk_tmpl") {
     # https://chromium.googlesource.com/chromium/src/+/main/docs/android_native_libraries.md#Crashpad-Packaging
     loadable_modules = []
     secondary_abi_loadable_modules = []
+    import("//vanadium/chromium_src/chrome/android/chrome_ext_args.gni")
+    if (!include_crashpad) {
+      not_needed([ "_secondary_out_dir" ])
+      # Empty loadable module for now until stub crashpad shared object is needed.
+    } else
     if (_include_primary_abi) {
       deps += [
         "//third_party/crashpad/crashpad/handler:crashpad_handler_trampoline",
diff --git a/vanadium/chromium_src/chrome/android/chrome_ext_args.gni b/vanadium/chromium_src/chrome/android/chrome_ext_args.gni
index 4c76245f15f45..34ce37bea69b4 100644
--- a/vanadium/chromium_src/chrome/android/chrome_ext_args.gni
+++ b/vanadium/chromium_src/chrome/android/chrome_ext_args.gni
@@ -3,4 +3,5 @@
 # found in the LICENSE file.
 
 declare_args() {
+  include_crashpad = false
 }
