From: quh4gko8 <88831734+quh4gko8@users.noreply.github.com>
Date: Tue, 19 May 2026 15:14:50 +0000
Subject: [PATCH] Reflect Javascript JIT site settings on page info based on
 memory DCL state

---
 .../permissions/android/ext/BUILD.gn          |  4 +++
 .../JavascriptJitPermissionsHooks.java        | 35 +++++++++++++++++++
 .../permissions/PermissionsHooksRegistry.java |  1 +
 3 files changed, 40 insertions(+)
 create mode 100644 vanadium/chromium_src/components/permissions/android/ext/java/src/org/chromium/components/permissions/JavascriptJitPermissionsHooks.java

diff --git a/vanadium/chromium_src/components/permissions/android/ext/BUILD.gn b/vanadium/chromium_src/components/permissions/android/ext/BUILD.gn
index 98ba867905ac8..4f7480b239e59 100644
--- a/vanadium/chromium_src/components/permissions/android/ext/BUILD.gn
+++ b/vanadium/chromium_src/components/permissions/android/ext/BUILD.gn
@@ -3,12 +3,16 @@ import("//third_party/jni_zero/jni_zero.gni")
 
 android_library("permissions_deps_java") {
   sources = [
+    "java/src/org/chromium/components/permissions/JavascriptJitPermissionsHooks.java",
     "java/src/org/chromium/components/permissions/PermissionsControllerHooks.java",
     "java/src/org/chromium/components/permissions/PermissionsHooksRegistry.java",
   ]
 
   deps = [
     "//components/content_settings/core/common:content_settings_types_java",
+    "//vanadium/android_config/parser:config_app_parser_java",
+    "//vanadium/android_config/proto:config_proto_java",
+    "//vanadium/ext/custom_os:custom_os_apis_java",
   ]
 
   srcjar_deps = [
diff --git a/vanadium/chromium_src/components/permissions/android/ext/java/src/org/chromium/components/permissions/JavascriptJitPermissionsHooks.java b/vanadium/chromium_src/components/permissions/android/ext/java/src/org/chromium/components/permissions/JavascriptJitPermissionsHooks.java
new file mode 100644
index 0000000000000..8dc4763fcf992
--- /dev/null
+++ b/vanadium/chromium_src/components/permissions/android/ext/java/src/org/chromium/components/permissions/JavascriptJitPermissionsHooks.java
@@ -0,0 +1,35 @@
+package org.chromium.components.permissions;
+
+import static app.vanadium.config.proto.VanadiumConfigProto.Flag.FlagType.DISABLED_FEATURE;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+
+import app.vanadium.config.VanadiumConfParser;
+import app.vanadium.ext.CustomOSApis;
+
+@NullMarked
+final class JavascriptJitPermissionsHooks {
+
+    private static boolean isMemoryDclRestricted() {
+        String featureKey = "CheckOsConfigsForJavascriptJitSiteSettingsForPermissions";
+        if (VanadiumConfParser.getFlagsFor(DISABLED_FEATURE).containsKey(featureKey)) {
+            return false;
+        }
+
+        Boolean isMemoryDclRestricted = CustomOSApis.isMemoryDclRestricted();
+        return isMemoryDclRestricted != null && isMemoryDclRestricted;
+    }
+
+    static final class PermissionsControllerHooksImpl extends PermissionsControllerHooks {
+
+        @Override
+        public @Nullable Boolean treatAsAllowedPageInfoOverride() {
+            if (isMemoryDclRestricted()) {
+                return false;
+            }
+
+            return null;
+        }
+    }
+}
diff --git a/vanadium/chromium_src/components/permissions/android/ext/java/src/org/chromium/components/permissions/PermissionsHooksRegistry.java b/vanadium/chromium_src/components/permissions/android/ext/java/src/org/chromium/components/permissions/PermissionsHooksRegistry.java
index 26c251271cd90..170419b1821cf 100644
--- a/vanadium/chromium_src/components/permissions/android/ext/java/src/org/chromium/components/permissions/PermissionsHooksRegistry.java
+++ b/vanadium/chromium_src/components/permissions/android/ext/java/src/org/chromium/components/permissions/PermissionsHooksRegistry.java
@@ -9,6 +9,7 @@ public final class PermissionsHooksRegistry {
     public static PermissionsControllerHooks getPermissionsControllerHooks(
             @ContentSettingsType.EnumType int contentSettingsType) {
         return switch (contentSettingsType) {
+            case ContentSettingsType.JAVASCRIPT_JIT -> new JavascriptJitPermissionsHooks.PermissionsControllerHooksImpl();
             default -> PermissionsControllerHooks.getDefaultInstance();
         };
     }
