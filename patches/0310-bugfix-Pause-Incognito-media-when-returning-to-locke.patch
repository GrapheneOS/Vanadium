+    // Media in locked Incognito tabs shouldn't keep playing once Chrome is back in the foreground,
+    // whether or not the Incognito tab model is currently selected. This is the same as the user
+    // pressing pause, so it can be resumed after unlocking.
+    private void suspendIncognitoMedia() {
+        TabModel incognitoTabModel = mTabModelSelector.getModel(/* incognito= */ true);
+        for (int i = 0; i < incognitoTabModel.getCount(); i++) {
+            Tab tab = incognitoTabModel.getTabAt(i);
+            if (tab == null) continue;
+            WebContents webContents = tab.getWebContents();
+            if (webContents == null) continue;
+            MediaSession mediaSession =
+                    sMediaSessionForTesting != null
+                            ? sMediaSessionForTesting
+                            : MediaSession.fromWebContents(webContents);
+            if (!mediaSession.isControllable()) continue;
+            mediaSession.suspend(SuspendType.UI);
+        }
+    }
+
