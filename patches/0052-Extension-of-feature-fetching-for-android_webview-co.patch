diff --git a/vanadium/chromium_src/android_webview/common/ext/java/src/org/chromium/android_webview/common/AwExtFeatureMap.java b/vanadium/chromium_src/android_webview/common/ext/java/src/org/chromium/android_webview/common/AwExtFeatureMap.java
new file mode 100644
index 0000000000000..738ff97685ac2
--- /dev/null
+++ b/vanadium/chromium_src/android_webview/common/ext/java/src/org/chromium/android_webview/common/AwExtFeatureMap.java
@@ -0,0 +1,42 @@
+package org.chromium.android_webview.common;
+
+import org.jni_zero.JNINamespace;
+import org.jni_zero.NativeMethods;
+
+import org.chromium.base.FeatureMap;
+import org.chromium.base.Log;
+import org.chromium.build.annotations.NonNull;
+import org.chromium.build.annotations.NullMarked;
+
+@JNINamespace("android_webview")
+@NullMarked
+public final class AwExtFeatureMap extends FeatureMap {
+
+    private static final String TAG = "AwExtFeatureMap";
+
+    @NonNull
+    private static final AwExtFeatureMap sInstance =
+            new AwExtFeatureMap();
+
+    private AwExtFeatureMap() {
+    }
+
+    @NonNull
+    public static AwExtFeatureMap getInstance() {
+        return sInstance;
+    }
+
+    public static boolean isEnabled(String featureName) {
+        return getInstance().isEnabledInNative(featureName);
+    }
+
+    @Override
+    protected long getNativeMap() {
+        return AwExtFeatureMapJni.get().getNativeMap();
+    }
+
+    @NativeMethods
+    public interface Natives {
+        long getNativeMap();
+    }
+}
