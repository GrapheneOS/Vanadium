diff --git a/vanadium/chromium_src/android_webview/common/ext/BUILD.gn b/vanadium/chromium_src/android_webview/common/ext/BUILD.gn
new file mode 100644
index 0000000000000..7f2bccb502962
--- /dev/null
+++ b/vanadium/chromium_src/android_webview/common/ext/BUILD.gn
@@ -0,0 +1,53 @@
+import("//build/config/android/rules.gni")
+import("//third_party/jni_zero/jni_zero.gni")
+
+source_set("features") {
+  sources = [
+    "features.cc",
+    "features.h",
+  ]
+
+  deps = [
+    ":feature_map_jni_headers",
+    "//base",
+  ]
+
+  public_deps = [
+  ]
+}
+
+java_cpp_features("features_srcjar") {
+  # External code should depend on ":features_java" instead.
+  visibility = [ ":*" ]
+  sources = [ "features.cc" ]
+  class_name = "org.chromium.android_webview.common.AwExtFeatures"
+}
+
+android_library("features_java") {
+  srcjar_deps = [ ":features_srcjar" ]
+}
+
+android_library("feature_map_java") {
+  sources = [
+    "java/src/org/chromium/android_webview/common/AwExtFeatureList.java",
+    "java/src/org/chromium/android_webview/common/AwExtFeatureMap.java",
+  ]
+
+  deps = [
+    ":features_java",
+    "//base:base_java",
+    "//build/android:build_java",
+    "//third_party/jni_zero:jni_zero_java",
+  ]
+
+  srcjar_deps = [
+    ":feature_map_jni_headers",
+  ]
+}
+
+generate_jni("feature_map_jni_headers") {
+  visibility = [ ":*" ]
+  sources = [
+    "java/src/org/chromium/android_webview/common/AwExtFeatureMap.java",
+  ]
+}
diff --git a/vanadium/chromium_src/android_webview/common/ext/features.cc b/vanadium/chromium_src/android_webview/common/ext/features.cc
new file mode 100644
index 0000000000000..df101908ae4fb
--- /dev/null
+++ b/vanadium/chromium_src/android_webview/common/ext/features.cc
@@ -0,0 +1,33 @@
+#include "vanadium/chromium_src/android_webview/common/ext/features.h"
+
+#include "base/android/feature_map.h"
+#include "base/android/jni_android.h"
+#include "base/feature_list.h"
+#include "base/metrics/field_trial_params.h"
+#include "base/no_destructor.h"
+
+#include "vanadium/chromium_src/android_webview/common/ext/feature_map_jni_headers/AwExtFeatureMap_jni.h"
+
+namespace android_webview {
+
+namespace {
+
+const base::Feature* const kFeaturesExposedToJava[] = {
+};
+
+// static
+base::android::FeatureMap* GetFeatureMap() {
+  static base::NoDestructor<base::android::FeatureMap> kFeatureMap(
+      kFeaturesExposedToJava);
+  return kFeatureMap.get();
+}
+
+} // namespace
+
+static jlong JNI_AwExtFeatureMap_GetNativeMap(JNIEnv* env) {
+  return reinterpret_cast<jlong>(GetFeatureMap());
+}
+
+} // namespace android_webview
+
+DEFINE_JNI(AwExtFeatureMap)
