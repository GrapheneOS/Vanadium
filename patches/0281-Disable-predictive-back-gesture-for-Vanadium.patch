From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: quh4gko8 <88831734+quh4gko8@users.noreply.github.com>
Date: Tue, 13 Aug 2024 06:07:33 +0000
Subject: [PATCH] Disable predictive back gesture for Vanadium

---
 chrome/android/java/AndroidManifest.xml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/chrome/android/java/AndroidManifest.xml b/chrome/android/java/AndroidManifest.xml
index 0c2ea220f4fa1..93f69a7d62277 100644
--- a/chrome/android/java/AndroidManifest.xml
+++ b/chrome/android/java/AndroidManifest.xml
@@ -245,7 +245,7 @@ by a child template that "extends" this file.
         {% endif %}
         android:networkSecurityConfig="@xml/network_security_config"
         android:appComponentFactory="org.chromium.chrome.browser.base.SplitCompatAppComponentFactory"
-        android:enableOnBackInvokedCallback="true"
+        android:enableOnBackInvokedCallback="false"
         android:zygotePreloadNativeLib="lib{{ library_name }}.so"
         {% if is_32_bit_multiarch_browser is defined and is_32_bit_multiarch_browser == 'true' %}
         android:multiArch="true"
