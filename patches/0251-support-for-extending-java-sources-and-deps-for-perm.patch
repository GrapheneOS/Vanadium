From: quh4gko8 <88831734+quh4gko8@users.noreply.github.com>
Date: Tue, 19 May 2026 14:06:45 +0000
Subject: [PATCH] support for extending java sources and deps for permissions
 component layer

---
 components/permissions/android/BUILD.gn                     | 5 +++++
 .../android/permissions_android_java_ext_deps.gni           | 6 ++++++
 .../android/permissions_android_java_ext_sources.gni        | 6 ++++++
 3 files changed, 17 insertions(+)
 create mode 100644 components/permissions/android/permissions_android_java_ext_deps.gni
 create mode 100644 components/permissions/android/permissions_android_java_ext_sources.gni

diff --git a/components/permissions/android/BUILD.gn b/components/permissions/android/BUILD.gn
index 943eb4b4c35d4..7686f24f27537 100644
--- a/components/permissions/android/BUILD.gn
+++ b/components/permissions/android/BUILD.gn
@@ -207,6 +207,11 @@ android_library("java") {
     "//third_party/jni_zero:jni_zero_java",
     "//ui/android:ui_java",
   ]
+  import("permissions_android_java_ext_sources.gni")
+  sources += permissions_android_java_ext_sources
+  import("permissions_android_java_ext_deps.gni")
+  deps += permissions_android_java_ext_deps
+
   resources_package = "org.chromium.components.permissions"
 }
 
diff --git a/components/permissions/android/permissions_android_java_ext_deps.gni b/components/permissions/android/permissions_android_java_ext_deps.gni
new file mode 100644
index 0000000000000..a2226179d1ed6
--- /dev/null
+++ b/components/permissions/android/permissions_android_java_ext_deps.gni
@@ -0,0 +1,6 @@
+# Copyright 2020 The Chromium Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+permissions_android_java_ext_deps = [
+]
\ No newline at end of file
diff --git a/components/permissions/android/permissions_android_java_ext_sources.gni b/components/permissions/android/permissions_android_java_ext_sources.gni
new file mode 100644
index 0000000000000..a087edf304c67
--- /dev/null
+++ b/components/permissions/android/permissions_android_java_ext_sources.gni
@@ -0,0 +1,6 @@
+# Copyright 2020 The Chromium Authors
