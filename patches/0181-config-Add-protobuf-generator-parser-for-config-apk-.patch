diff --git a/vanadium/android_config/proto/host/java/src/app/vanadium/config/host/ConfigGeneratorImpl.kt b/vanadium/android_config/proto/host/java/src/app/vanadium/config/host/ConfigGeneratorImpl.kt
new file mode 100644
index 0000000000000..846f0dd5c4ee6
--- /dev/null
+++ b/vanadium/android_config/proto/host/java/src/app/vanadium/config/host/ConfigGeneratorImpl.kt
@@ -0,0 +1,239 @@
+package app.vanadium.config.host
+
+import app.vanadium.config.proto.VanadiumConfigProto.Component
+import app.vanadium.config.proto.VanadiumConfigProto.Component.AdditionalComponent
+import app.vanadium.config.proto.VanadiumConfigProto.Component.ComponentCondition
+import app.vanadium.config.proto.VanadiumConfigProto.Component.ComponentType
+import app.vanadium.config.proto.VanadiumConfigProto.Config
+import app.vanadium.config.proto.VanadiumConfigProto.Configs
+import app.vanadium.config.proto.VanadiumConfigProto.Flag
+import app.vanadium.config.proto.VanadiumConfigProto.Flag.FlagType
+import app.vanadium.config.proto.VanadiumConfigProto.Spec
+import app.vanadium.config.proto.VanadiumConfigProto.Spec.SpecType
+import app.vanadium.config.proto.VanadiumConfigProto.Spec.SysFeatureCondition
+
+import com.google.protobuf.Internal.EnumLite
+
+import java.io.FileOutputStream
+
+import kotlin.IllegalArgumentException
+import kotlin.Int
+import kotlin.String
+import kotlin.Unit
+import kotlin.run
+
+
+fun main(vararg args: String) {
+    var outFile: String? = null
+    val iter = args.iterator()
+    while (iter.hasNext()) {
+        when (val curArg = iter.next()) {
+            "-o", "--out_file", "--out-file", "-o=", "--out_file=", "--out-file=" -> {
+                if (!iter.hasNext()) {
+                    throw IllegalArgumentException("Missing args for file")
+                }
+                outFile = iter.next()
+                continue
+            }
+            else -> {
+                if (curArg.startsWith("-o=")
+                    || curArg.startsWith("--out-file=")
+                    || curArg.startsWith("--out_file=")
+                ) {
+                    outFile = curArg.split("=")[1]
+                    continue
+                }
+                throw IllegalArgumentException("Unrecognized argument")
+            }
+        }
+    }
+
+    if (outFile.isNullOrBlank()) {
+        throw IllegalArgumentException("Missing output file argument")
+    }
+
+    FileOutputStream(outFile).use {
+        configs().writeTo(it)
+    }
+}
+
+private fun configs(): Configs {
+    val configs = ArrayList<Config>()
+
+    return sortConfigs(configs)
+}
+
+
+private fun sortConfigs(configList: List<Config>): Configs {
+    return Configs.newBuilder().addAllConfigs(
+        configList.sortedWith { config: Config, otherConfig: Config ->
+            val spec = config.spec
+            val otherSpec = otherConfig.spec
+            val specTypeCmp = spec.specTypes.compareTo(otherSpec.specTypes)
+            if (specTypeCmp != 0) {
+                return@sortedWith specTypeCmp
+            }
+
+            val minVerCmp = spec.minVersion.compareTo(otherSpec.minVersion)
+            if (minVerCmp != 0) {
+                return@sortedWith minVerCmp
+            }
+
+            val maxVerCmp = spec.maxVersion.compareTo(otherSpec.maxVersion)
+            if (maxVerCmp != 0) {
+                return@sortedWith maxVerCmp
+            }
+
+            0
+    }).build()
+}
+
+private fun config(
+    components: List<Component>,
+    flags: List<Flag>,
+    block: Config.Builder.() -> Unit,
+): Config {
+    return Config.newBuilder().run {
+        addAllComponents(components)
+        addAllFlags(flags)
+        block(this)
+        build()
+    }
+}
+
+private fun config(
+    spec: Spec,
+    components: List<Component>,
+    flags: List<Flag>,
+    block: Config.Builder.() -> Unit,
+): Config {
+    return Config.newBuilder().run {
+        setSpec(spec)
+        addAllComponents(components)
+        addAllFlags(flags)
+        block(this)
+        build()
+    }
+}
+
+private fun config(block: Config.Builder.() -> Unit): Config {
+    return Config.newBuilder().run {
+        block(this)
+        build()
+    }
+}
+
+private fun spec(block: Spec.Builder.() -> Unit): Spec {
+    return Spec.newBuilder().run {
+        block(this)
+        build()
+    }
+}
+
+private fun sysFeatureConditions(
+    vararg sysFeatureConditions: SysFeatureCondition
+): List<SysFeatureCondition> {
+    return listOf(*sysFeatureConditions)
+}
+
+private fun sysFeatureCondition(block: SysFeatureCondition.Builder.() -> Unit): SysFeatureCondition {
+    return SysFeatureCondition.newBuilder().run {
+        block(this)
+        build()
+    }
+}
+
+private fun flags(vararg flags: Flag): List<Flag> {
+    return listOf(*flags)
+}
+
+private fun flag(block: Flag.Builder.() -> Unit): Flag {
+    return Flag.newBuilder().run {
+        block(this)
+        build()
+    }
+}
+
+private fun components(vararg components: Component): List<Component> {
+    return listOf(*components)
+}
+
+private fun component(
+    additionalComponents: List<AdditionalComponent>,
+    dependentFlags: List<Flag>,
+    block: Component.Builder.() -> Unit,
+): Component {
+    return Component.newBuilder().run {
+        addAllAdditionalComponents(additionalComponents)
+        addAllDependentFlags(dependentFlags)
+        block(this)
+        build()
+    }
+}
+
+private fun component(block: Component.Builder.() -> Unit): Component {
+    return Component.newBuilder().run {
+        block(this)
+        build()
+    }
+}
+
+private fun additionalComponents(vararg additionalComponents: AdditionalComponent): List<AdditionalComponent> {
+    return listOf(*additionalComponents)
+}
+
+private fun additionalComponent(
+    componentConditions: List<ComponentCondition>,
+    block: AdditionalComponent.Builder.() -> Unit,
+): AdditionalComponent {
+    return AdditionalComponent.newBuilder().run {
+        addAllConditions(componentConditions)
+        block(this)
+        build()
+    }
+}
+
+private fun additionalComponent(block: AdditionalComponent.Builder.() -> Unit): AdditionalComponent {
+    return AdditionalComponent.newBuilder().run {
+        block(this)
+        build()
+    }
+}
+
+private fun componentConditions(vararg componentConditions: ComponentCondition): List<ComponentCondition> {
+    return listOf(*componentConditions)
+}
+
+private fun componentCondition(block: ComponentCondition.Builder.() -> Unit): ComponentCondition {
+    return ComponentCondition.newBuilder().run {
+        block(this)
+        build()
+    }
+}
+
+private fun getSpecTypes(vararg specTypes: SpecType): Long {
+    return enumBitsLong(*specTypes)
+}
+
+private fun enumBitsLong(vararg enumBits: EnumLite): Long {
+    var bits = 0L
+    for (enumBit in enumBits) {
+        bits = bits or (1L shl enumBit.getNumber())
+    }
+    return bits
+}
+
+private fun vanadiumVersion(major: Int, minor: Int, increment: Int = 0): Long {
+    check(major > 0)
+    check(minor in 0..999)
+    check(increment in 0..99)
+    return major * 100_000L + minor * 100L + increment
+}
+
+private fun grapheneOsVersion(year: Int, month: Int, day: Int, increment: Int = 0): Long {
+    check(year > 0)
+    check(month in 1..12)
+    check(day in 1..31)
+    check(increment in 0..100)
+    return year * 1_000_000L + month * 10_000L + day * 100L + increment
+}
diff --git a/vanadium/android_config/proto/host/java/src/app/vanadium/config/host/ConfigParser.java b/vanadium/android_config/proto/host/java/src/app/vanadium/config/host/ConfigParser.java
new file mode 100644
