+import("//build/config/android/rules.gni")
+
+java_binary("proto_config_generator_java") {
+  sources = [
+    "java/src/app/vanadium/config/host/ConfigGenerator.java",
+  ]
+  deps = [
+    ":proto_config_generator_impl_kt_java",
+  ]
+  # Needed to be able to compile this as a java binary with python script wrapper, for pb2 generation
+  bypass_platform_checks = true
+  # No need to enable checks for unused methods here.
+  enable_errorprone = false
+  main_class = "app.vanadium.config.host.ConfigGenerator"
+  wrapper_script_name = "android_config_apk/config_apk_generator.py"
+}
+
+java_library("proto_config_generator_impl_kt_java") {
+  sources = [
+    "java/src/app/vanadium/config/host/ConfigGeneratorImpl.kt",
+  ]
+
+  # Workaround for not detecting java dependency on build-time,
+  # along with the dependency list requiring the declarations below.
+  supports_android = true
+  requires_android = true
+  deps = [
+    "//vanadium/android_config/proto:config_proto_java",
+    "//third_party/kotlin_stdlib:kotlin_stdlib_java",
+    "//third_party/android_deps:protobuf_lite_runtime_java",
+  ]
+  # No need to enable checks for unused methods here.
+  enable_errorprone = false
+}
+
+java_binary("proto_config_parser_java") {
+  sources = [
+    "java/src/app/vanadium/config/host/ConfigParser.java",
+  ]
+  deps = [
+    "//vanadium/android_config/proto:config_proto_java",
+    "//third_party/android_deps:protobuf_lite_runtime_java",
+  ]
+  # Needed to be able to compile this as a java binary with python script wrapper, for pb2 generation
+  bypass_platform_checks = true
+  # No need to enable checks for unused methods here.
+  enable_errorprone = false
+  main_class = "app.vanadium.config.host.ConfigParser"
+  wrapper_script_name = "android_config_apk/config_apk_parser.py"
+}
