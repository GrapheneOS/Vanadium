From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: quh4gko8 <88831734+quh4gko8@users.noreply.github.com>
Date: Thu, 1 Feb 2024 17:58:40 +0000
Subject: [PATCH] Apply toggle for opening links in incognito for search tabs

Changes since:
  - 156.0.8078.79.0
    - Simplify hooks to better indicate intent modification.
    - Open web search action and other origins of search activity in
      incognito.
---
 .../document/ChromeLauncherActivity.java      |  2 ++
 .../searchwidget/SearchActivityUtils.java     |  3 +++
 .../browser/LaunchIntentDispatcherHooks.java  |  4 ++++
 .../searchwidget/SearchActivityHooks.java     | 20 +++++++++++++++++++
 4 files changed, 29 insertions(+)

diff --git a/chrome/android/java/src/org/chromium/chrome/browser/document/ChromeLauncherActivity.java b/chrome/android/java/src/org/chromium/chrome/browser/document/ChromeLauncherActivity.java
index f1dbd8c76bbdc..546f6feac5d12 100644
--- a/chrome/android/java/src/org/chromium/chrome/browser/document/ChromeLauncherActivity.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/document/ChromeLauncherActivity.java
@@ -240,6 +240,8 @@ public class ChromeLauncherActivity extends Activity {
             searchActivityIntent.setClass(
                     ContextUtils.getApplicationContext(), SearchActivity.class);
             searchActivityIntent.putExtra(SearchManager.QUERY, query);
+            org.chromium.chrome.browser.LaunchIntentDispatcherHooks.maybeModifySearchIntents(
+                    searchActivityIntent);
             startActivity(searchActivityIntent);
         }
         return true;
diff --git a/chrome/android/java/src/org/chromium/chrome/browser/searchwidget/SearchActivityUtils.java b/chrome/android/java/src/org/chromium/chrome/browser/searchwidget/SearchActivityUtils.java
index 5e4c5b03d4c9e..c47bf7c5b85f5 100644
--- a/chrome/android/java/src/org/chromium/chrome/browser/searchwidget/SearchActivityUtils.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/searchwidget/SearchActivityUtils.java
@@ -114,6 +114,9 @@ public class SearchActivityUtils {
 
     /** Returns the incognito status of the associated launching activity. */
     /* package */ static boolean getIntentIncognitoStatus(Intent intent) {
+        if (SearchActivityHooks.shouldOpenInIncognito(intent)) {
+            return true;
+        }
         return IntentUtils.isTrustedIntentFromSelf(intent)
                 && IntentUtils.safeGetBooleanExtra(
                         intent, SearchActivityExtras.EXTRA_IS_INCOGNITO, false);
diff --git a/vanadium/chromium_src/chrome/android/java/src/org/chromium/chrome/browser/LaunchIntentDispatcherHooks.java b/vanadium/chromium_src/chrome/android/java/src/org/chromium/chrome/browser/LaunchIntentDispatcherHooks.java
index 63947f16c6e40..9a8ed6329341f 100644
--- a/vanadium/chromium_src/chrome/android/java/src/org/chromium/chrome/browser/LaunchIntentDispatcherHooks.java
+++ b/vanadium/chromium_src/chrome/android/java/src/org/chromium/chrome/browser/LaunchIntentDispatcherHooks.java
@@ -22,4 +22,8 @@ public final class LaunchIntentDispatcherHooks {
     static void maybeModifyCustomTabIntents(Intent intent) {
         TabPreferencesUtils.maybeModifyNeededIncognitoExtras(intent);
     }
+
+    public static void maybeModifySearchIntents(Intent intent) {
+        TabPreferencesUtils.maybeModifyNeededIncognitoExtras(intent);
+    }
 }
diff --git a/vanadium/chromium_src/chrome/android/java/src/org/chromium/chrome/browser/searchwidget/SearchActivityHooks.java b/vanadium/chromium_src/chrome/android/java/src/org/chromium/chrome/browser/searchwidget/SearchActivityHooks.java
index 2f06751228fc1..68aeee348b665 100644
--- a/vanadium/chromium_src/chrome/android/java/src/org/chromium/chrome/browser/searchwidget/SearchActivityHooks.java
+++ b/vanadium/chromium_src/chrome/android/java/src/org/chromium/chrome/browser/searchwidget/SearchActivityHooks.java
@@ -1,7 +1,12 @@
 package org.chromium.chrome.browser.searchwidget;
 
+import static org.chromium.chrome.browser.ui.searchactivityutils.SearchActivityExtras.IntentOrigin.WEB_SEARCH;
+import static org.chromium.chrome.browser.ui.searchactivityutils.SearchActivityExtras.IntentOrigin.UNKNOWN;
+
 import android.content.Intent;
 
+import org.chromium.base.IntentUtils;
+import org.chromium.chrome.browser.IntentHandler;
 import org.chromium.chrome.browser.TabPreferencesUtils;
 
 public final class SearchActivityHooks {
@@ -9,4 +14,19 @@ public final class SearchActivityHooks {
     static void modifyIntentForStartActivity(Intent intent) {
         TabPreferencesUtils.maybeModifyNeededIncognitoExtras(intent);
     }
+
+    static boolean shouldOpenInIncognito(Intent intent) {
+        if (!TabPreferencesUtils.shouldOpenLinksInIncognito()) {
+            return false;
+        }
+
+        int origin = SearchActivityUtils.getIntentOrigin(intent);
+
+        if (origin == WEB_SEARCH || origin == UNKNOWN) {
+            return true;
+        }
+
+        return IntentUtils.safeGetBooleanExtra(intent,
+                IntentHandler.EXTRA_OPEN_NEW_INCOGNITO_TAB, false);
+    }
 }
