From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: quh4gko8 <88831734+quh4gko8@users.noreply.github.com>
Date: Tue, 29 Sep 2026 13:06:51 +0000
Subject: [PATCH] Extend //chrome/android base_module_java targets sources and
 deps

---
 chrome/android/BUILD.gn                       |  5 ++++
 .../android/base_module_java_ext_deps.gni     | 26 +++++++++++++++++++
 .../android/base_module_java_ext_sources.gni  | 26 +++++++++++++++++++
 3 files changed, 57 insertions(+)
 create mode 100644 vanadium/chromium_src/chrome/android/base_module_java_ext_deps.gni
 create mode 100644 vanadium/chromium_src/chrome/android/base_module_java_ext_sources.gni

diff --git a/chrome/android/BUILD.gn b/chrome/android/BUILD.gn
index a2691efa5c654..35029b9316d73 100644
--- a/chrome/android/BUILD.gn
+++ b/chrome/android/BUILD.gn
@@ -2310,6 +2310,11 @@ if (_is_default_toolchain) {
     # can provide their own implementations.
     jar_excluded_patterns = [ "*/ProductConfig.class" ]
 
+    import("//vanadium/chromium_src/chrome/android/base_module_java_ext_sources.gni")
+    sources += base_module_java_ext_sources
+    import("//vanadium/chromium_src/chrome/android/base_module_java_ext_deps.gni")
+    deps += base_module_java_ext_deps
+
     resources_package = "org.chromium.chrome.base"
   }
 
diff --git a/vanadium/chromium_src/chrome/android/base_module_java_ext_deps.gni b/vanadium/chromium_src/chrome/android/base_module_java_ext_deps.gni
new file mode 100644
index 0000000000000..376d730100896
--- /dev/null
+++ b/vanadium/chromium_src/chrome/android/base_module_java_ext_deps.gni
@@ -0,0 +1,26 @@
+# Copyright 2023-2026 GrapheneOS
+# Use of this source code is governed by a GPL-2.0-only style license that can be
+# found in the LICENSE file.
+
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+base_module_java_ext_full_path_deps = [
+]
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+base_module_java_ext_rel_path_deps = [
+]
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+base_module_java_ext_deps = [
+]
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+base_module_java_ext_deps += base_module_java_ext_full_path_deps
+foreach(rel_path, base_module_java_ext_rel_path_deps) {
+  base_module_java_ext_deps += [ rebase_path(rel_path) ]
+}
diff --git a/vanadium/chromium_src/chrome/android/base_module_java_ext_sources.gni b/vanadium/chromium_src/chrome/android/base_module_java_ext_sources.gni
new file mode 100644
index 0000000000000..ada85ff878136
--- /dev/null
+++ b/vanadium/chromium_src/chrome/android/base_module_java_ext_sources.gni
@@ -0,0 +1,26 @@
+# Copyright 2023-2026 GrapheneOS
+# Use of this source code is governed by a GPL-2.0-only style license that can be
+# found in the LICENSE file.
+
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+base_module_java_ext_full_path_sources = [
+]
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+base_module_java_ext_rel_path_sources = [
+]
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+base_module_java_ext_sources = [
+]
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+base_module_java_ext_sources += base_module_java_ext_full_path_sources
+foreach(rel_path, base_module_java_ext_rel_path_sources) {
+  base_module_java_ext_sources += [ rebase_path(rel_path) ]
+}
