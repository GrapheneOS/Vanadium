Subject: [PATCH] Add needed visibility allowlist for custom browser and
 webview targets

---
 third_party/libwebp/visibility.gni | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/third_party/libwebp/visibility.gni b/third_party/libwebp/visibility.gni
index 03012cc382eae..032fc0bf9f940 100644
--- a/third_party/libwebp/visibility.gni
+++ b/third_party/libwebp/visibility.gni
@@ -23,4 +23,6 @@ cwebp_exe_allowed_visibility = [
   "//chrome/android/*",
   "//clank/android_webview/*",
   "//clank/java/*",
+  "//vanadium/chromium_src/android_webview/*",
+  "//vanadium/chromium_src/chrome/android/*",
 ]
