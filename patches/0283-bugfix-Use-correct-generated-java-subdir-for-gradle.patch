From: quh4gko8 <88831734+quh4gko8@users.noreply.github.com>
Date: Mon, 29 Jun 2026 09:03:24 +0000
Subject: [PATCH] [bugfix] Use correct generated java subdir for gradle

---
 build/android/gradle/generate_gradle.py | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/build/android/gradle/generate_gradle.py b/build/android/gradle/generate_gradle.py
index 6de072b53467a..38e7b8d3a0d40 100755
--- a/build/android/gradle/generate_gradle.py
+++ b/build/android/gradle/generate_gradle.py
@@ -50,6 +50,7 @@ _DEFAULT_ANDROID_MANIFEST_PATH = os.path.join(
     'AndroidManifest.xml')
 _FILE_DIR = os.path.dirname(__file__)
 _GENERATED_JAVA_SUBDIR = 'generated_java'
+_GENERATED_JAVA_SUBDIR_CHILD = 'input_srcjars'
 _JNI_LIBS_SUBDIR = 'symlinked-libs'
 _ARMEABI_SUBDIR = 'armeabi'
 _GRADLE_BUILD_FILE = 'build.gradle'
@@ -200,7 +201,7 @@ class _ProjectEntry:
 
   def GeneratedJavaSubdir(self):
     return _RebasePath(
-        os.path.join('gen', self.GradleSubdir(), _GENERATED_JAVA_SUBDIR))
+        os.path.join('gen', self.GradleSubdir(), _GENERATED_JAVA_SUBDIR, _GENERATED_JAVA_SUBDIR_CHILD))
 
   def ProjectName(self):
     """Returns the Gradle project name."""
