From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: quh4gko8 <88831734+quh4gko8@users.noreply.github.com>
Date: Wed, 26 Feb 2025 09:46:02 +0000
Subject: [PATCH] Always allow platform CredentialManager calls for Android 15+

---
 .../webauthn/AuthenticatorImpl.java           | 24 +++++++++++++++++++
 .../cred_man/CredManSupportProvider.java      |  8 ++++++-
 2 files changed, 31 insertions(+), 1 deletion(-)

diff --git a/components/webauthn/android/java/src/org/chromium/components/webauthn/AuthenticatorImpl.java b/components/webauthn/android/java/src/org/chromium/components/webauthn/AuthenticatorImpl.java
index 6b16b28446c40..c09833365c5f0 100644
--- a/components/webauthn/android/java/src/org/chromium/components/webauthn/AuthenticatorImpl.java
+++ b/components/webauthn/android/java/src/org/chromium/components/webauthn/AuthenticatorImpl.java
@@ -361,6 +361,11 @@ public final class AuthenticatorImpl implements Authenticator, AuthenticationCon
     }
 
     private boolean couldSupportConditionalMediation() {
+        // START CHANGE downstream: Check if CredMan usage without GMS is possible for browser.
+        if (canUseCredManWithoutGms() && isChrome(mWebContents)) {
+            return true;
+        }
+        // END CHANGE downstream: Check if CredMan usage without GMS is possible for browser.
         return GmsCoreUtils.isWebauthnSupported() && isChrome(mWebContents);
     }
 
@@ -370,6 +375,11 @@ public final class AuthenticatorImpl implements Authenticator, AuthenticationCon
      * Android Credential Manager or a GMSCore that can respond via ResultReceiver.
      */
     private boolean hasCredentialBackend() {
+        // START CHANGE downstream: Check if CredMan usage without GMS is possible.
+        if (canUseCredManWithoutGms()) {
+            return true;
+        }
+        // END CHANGE downstream: Check if CredMan usage without GMS is possible.
         if (isChrome(mWebContents)) {
             return GmsCoreUtils.isWebauthnSupported();
         }
@@ -377,6 +387,20 @@ public final class AuthenticatorImpl implements Authenticator, AuthenticationCon
                 || CredManSupportProvider.getCredManSupportForWebView() != CredManSupport.DISABLED;
     }
 
+    // START CHANGE downstream: Check if CredMan usage without GMS is possible.
+    private boolean canUseCredManWithoutGms() {
+        if (!CredManSupportProvider.isGmsIndependentCredManVersion()) {
+            return false;
+        }
+
+        if (isChrome(mWebContents)) {
+            return CredManSupportProvider.getCredManSupport() != CredManSupport.DISABLED;
+        }
+
+        return CredManSupportProvider.getCredManSupportForWebView() != CredManSupport.DISABLED;
+    }
+    // END CHANGE downstream: Check if CredMan usage without GMS is possible.
+
     @Override
     public void isUserVerifyingPlatformAuthenticatorAvailable(
             final IsUserVerifyingPlatformAuthenticatorAvailable_Response callback) {
diff --git a/components/webauthn/android/java/src/org/chromium/components/webauthn/cred_man/CredManSupportProvider.java b/components/webauthn/android/java/src/org/chromium/components/webauthn/cred_man/CredManSupportProvider.java
index 7c34e180e73fc..1b064a5ba5745 100644
--- a/components/webauthn/android/java/src/org/chromium/components/webauthn/cred_man/CredManSupportProvider.java
+++ b/components/webauthn/android/java/src/org/chromium/components/webauthn/cred_man/CredManSupportProvider.java
@@ -53,6 +53,12 @@ public class CredManSupportProvider {
                 });
     }
 
+    // START CHANGE downstream: use Android 15+ CredMan without requiring GMS
+    public static boolean isGmsIndependentCredManVersion() {
+        return getAndroidVersion() >= Build.VERSION_CODES.VANILLA_ICE_CREAM;
+    }
+    // END CHANGE downstream: use Android 15+ CredMan without requiring GMS
+
     @CalledByNative
     public static @CredManSupport int getCredManSupport() {
         if (sCredManSupport != CredManSupport.NOT_EVALUATED) {
@@ -66,7 +72,7 @@ public class CredManSupportProvider {
             log(TAG, "Disabled because of Android version.");
             return sCredManSupport;
         }
-        if (notSkippedBecauseInTests() && hasOldGmsVersion()) {
+        if (!isGmsIndependentCredManVersion() && notSkippedBecauseInTests() && hasOldGmsVersion()) {
             sCredManSupport = CredManSupport.DISABLED;
             log(TAG, "Disabled because of old GMS version.");
             return sCredManSupport;
