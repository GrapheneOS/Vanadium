diff --git a/vanadium/subprojects_patches/v8/0003-wasm-interpreter-Fix-build-break-after-upstream-refa.patch b/vanadium/subprojects_patches/v8/0003-wasm-interpreter-Fix-build-break-after-upstream-refa.patch
