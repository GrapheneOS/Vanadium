@@ -0,0 +1,12 @@
+package org.chromium.components.page_info;
+
+import org.chromium.components.content_settings.ContentSettingsType;
+
+public final class PageInfoHooksRegistry {
+    static PageInfoPermissionControllerHooks getPermissionControllerHooks(
+            @ContentSettingsType.EnumType int contentSettingsType) {
+        return switch (contentSettingsType) {
+            default -> PageInfoPermissionControllerHooks.getDefaultInstance();
+        };
+    }
+}
diff --git a/components/page_info/android/downstream/java/src/org/chromium/components/page_info/PageInfoPermissionControllerHooks.java b/components/page_info/android/downstream/java/src/org/chromium/components/page_info/PageInfoPermissionControllerHooks.java
new file mode 100644
index 0000000000000..cbc9f1ef26464
--- /dev/null
+++ b/components/page_info/android/downstream/java/src/org/chromium/components/page_info/PageInfoPermissionControllerHooks.java
@@ -0,0 +1,29 @@
+package org.chromium.components.page_info;
+
+import org.chromium.build.annotations.NonNull;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+
+@NullMarked
+class PageInfoPermissionControllerHooks {
+
+    private static final class LazyHolder {
+        @NonNull
+        private static final PageInfoPermissionControllerHooks INSTANCE =
+                new PageInfoPermissionControllerHooks();
+    }
+
+    @NonNull
+    static PageInfoPermissionControllerHooks getDefaultInstance() {
+        return LazyHolder.INSTANCE;
+    }
+
+    final boolean isDefaultInstance() {
+        return getDefaultInstance() == this;
+    }
+
+    @Nullable
+    Boolean treatAsAllowedOverride() {
+        return null;
+    }
+}
diff --git a/components/page_info/android/java/src/org/chromium/components/page_info/PageInfoPermissionsController.java b/components/page_info/android/java/src/org/chromium/components/page_info/PageInfoPermissionsController.java
index 3f9a0087427f7..5718120809e70 100644
--- a/components/page_info/android/java/src/org/chromium/components/page_info/PageInfoPermissionsController.java
+++ b/components/page_info/android/java/src/org/chromium/components/page_info/PageInfoPermissionsController.java
@@ -57,6 +57,14 @@ public class PageInfoPermissionsController extends PageInfoPreferenceSubpageCont
                 boolean allowed,
                 int warningTextResource,
                 boolean requested) {
+            PageInfoPermissionControllerHooks hooks =
+                    PageInfoHooksRegistry.getPermissionControllerHooks(type);
+            if (!hooks.isDefaultInstance()) {
+                Boolean allowedOverride = hooks.treatAsAllowedOverride();
+                if (allowedOverride != null) {
+                    allowed = allowedOverride;
+                }
+            }
             this.type = type;
             this.name = name;
             this.nameMidSentence = nameMidSentence;
