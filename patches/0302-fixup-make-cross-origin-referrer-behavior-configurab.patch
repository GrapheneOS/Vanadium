@@ -381,6 +381,44 @@ std::string ComputeUserAgentValue(const std::string& user_agent_override) {
   return GetContentClient()->browser()->GetUserAgent();
 }
 
+void ApplyCrossOriginReferrerPolicy(
+    FrameTreeNode* frame_tree_node,
+    const GURL& url,
+    blink::mojom::Referrer* referrer,
+    bool should_sanitize) {
+  if (referrer->url.is_empty() || url::IsSameOriginWith(url, referrer->url)) {
+    return;
+  }
+
+  RenderViewHostImpl* render_view_host =
+      frame_tree_node->current_frame_host()->render_view_host();
+  switch (render_view_host->GetDelegate()
+              ->GetRendererPrefs(render_view_host)
+              .cross_origin_referrer_policy) {
+    case network::mojom::CrossOriginReferrerPolicy::kDefault:{
+      break;
+    }
+    case network::mojom::CrossOriginReferrerPolicy::kReduce: {
+      auto capped_referrer = url::Origin::Create(referrer->url);
+      auto reduced_referrer = blink::mojom::Referrer(
+          capped_referrer.GetURL(),
+          network::mojom::ReferrerPolicy::kOriginWhenCrossOrigin);
+      if (should_sanitize) {
+        *referrer = *Referrer::SanitizeForRequest(
+            capped_referrer.GetURL(), reduced_referrer);
+      } else {
+        *referrer = reduced_referrer;
+      }
+      break;
+    }
+    case network::mojom::CrossOriginReferrerPolicy::kDisable: {
+      *referrer = blink::mojom::Referrer(
+          GURL(), network::mojom::ReferrerPolicy::kSameOrigin);
+      break;
+    }
+  }
+}
