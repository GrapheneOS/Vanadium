From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: quh4gko8 <88831734+quh4gko8@users.noreply.github.com>
Date: Thu, 1 Feb 2024 17:58:19 +0000
Subject: [PATCH] Apply toggle for opening links in incognito for custom tabs

Changes since:
  - 156.0.8078.79.0
    - Simplify hooks to better indicate intent modification.
    - Treat intents modified with open external links in incognito as valid
      incognito custom tab intent.
---
 .../org/chromium/chrome/browser/LaunchIntentDispatcher.java   | 1 +
 .../customtabs/IncognitoCustomTabIntentDataProvider.java      | 3 +++
 .../chromium/chrome/browser/LaunchIntentDispatcherHooks.java  | 4 ++++
 3 files changed, 8 insertions(+)

diff --git a/chrome/android/java/src/org/chromium/chrome/browser/LaunchIntentDispatcher.java b/chrome/android/java/src/org/chromium/chrome/browser/LaunchIntentDispatcher.java
index 80a587fb45c60..494445f8471a5 100644
--- a/chrome/android/java/src/org/chromium/chrome/browser/LaunchIntentDispatcher.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/LaunchIntentDispatcher.java
@@ -336,6 +336,7 @@ public class LaunchIntentDispatcher {
             newIntent.setData(uri);
         }
         newIntent.setClassName(context, CustomTabActivity.class.getName());
+        LaunchIntentDispatcherHooks.maybeModifyCustomTabIntents(newIntent);
         // Make sure the result of the CustomTabActivity is forwarded to the client.
         newIntent.addFlags(Intent.FLAG_ACTIVITY_FORWARD_RESULT);
 
diff --git a/chrome/android/java/src/org/chromium/chrome/browser/customtabs/IncognitoCustomTabIntentDataProvider.java b/chrome/android/java/src/org/chromium/chrome/browser/customtabs/IncognitoCustomTabIntentDataProvider.java
index f3f28df683fbd..feed7d30080a0 100644
--- a/chrome/android/java/src/org/chromium/chrome/browser/customtabs/IncognitoCustomTabIntentDataProvider.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/customtabs/IncognitoCustomTabIntentDataProvider.java
@@ -215,6 +215,9 @@ public class IncognitoCustomTabIntentDataProvider extends BrowserServicesIntentD
 
     public static boolean isValidIncognitoIntent(Intent intent, boolean recordMetrics) {
         if (!isIncognitoRequested(intent)) return false;
+        if (org.chromium.chrome.browser.TabPreferencesUtils.shouldOpenExternalLinksInIncognito(intent)) {
+            return true;
+        }
         var session = SessionHolder.getSessionHolderFromIntent(intent);
         if (isIntentFromThirdPartyAllowed()
                 && getClientPackageNameFromSessionOrCallingActivity(intent, session) != null) {
diff --git a/vanadium/chromium_src/chrome/android/java/src/org/chromium/chrome/browser/LaunchIntentDispatcherHooks.java b/vanadium/chromium_src/chrome/android/java/src/org/chromium/chrome/browser/LaunchIntentDispatcherHooks.java
index 8b86b257e924e..63947f16c6e40 100644
--- a/vanadium/chromium_src/chrome/android/java/src/org/chromium/chrome/browser/LaunchIntentDispatcherHooks.java
+++ b/vanadium/chromium_src/chrome/android/java/src/org/chromium/chrome/browser/LaunchIntentDispatcherHooks.java
@@ -18,4 +18,8 @@ public final class LaunchIntentDispatcherHooks {
 
         TabPreferencesUtils.maybeModifyNeededIncognitoExtras(intent);
     }
+
+    static void maybeModifyCustomTabIntents(Intent intent) {
+        TabPreferencesUtils.maybeModifyNeededIncognitoExtras(intent);
+    }
 }
