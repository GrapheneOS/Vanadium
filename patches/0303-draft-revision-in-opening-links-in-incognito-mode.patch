+
+    /** Intent extra used to identify if it should be opened in incognito via settings. */
+    public static final String OPEN_EXTERNAL_LINKS_INCOGNITO_EXTRA =
+            "open_external_links_incognito_extra";
+
+    /** Fake ComponentName used in constructing OPEN_EXTERNAL_LINKS_INCOGNITO_EXTRA. */
+    private static @Nullable ComponentName sFakeComponentName;
+
+    private static final Object COMPONENT_NAME_LOCK = new Object();
+    private static boolean sForcedIncognitoModeForTesting;
+
+    private static ComponentName getFakeComponentName(String packageName) {
+        synchronized (COMPONENT_NAME_LOCK) {
+            if (sFakeComponentName == null) {
+                byte[] token = new byte[32];
+                new SecureRandom().nextBytes(token);
+                String component = Base64.getUrlEncoder().encodeToString(token);
+                sFakeComponentName = new ComponentName(packageName, "FakeClassExt_" + component);
+            }
+        }
+
+        return sFakeComponentName;
+    }
+
+
+    private static PendingIntent getAuthenticationToken() {
+        Intent fakeIntent = new Intent();
+        Context appContext = ContextUtils.getApplicationContext();
+        fakeIntent.setComponent(getFakeComponentName(appContext.getPackageName()));
+        return PendingIntent.getActivity(
+                appContext, 0, fakeIntent, PendingIntent.FLAG_IMMUTABLE);
+    }
+
+    @Contract("null -> false")
+    private static boolean hasTrustedTokenToOpenInIncognito(@Nullable Intent intent) {
+        if (intent == null) return false;
+
+        if (sForcedIncognitoModeForTesting) return true;
+
+        PendingIntent token =
+                IntentUtils.safeGetParcelableExtra(intent, OPEN_EXTERNAL_LINKS_INCOGNITO_EXTRA);
+        if (token == null) return false;
+
+        PendingIntent pending = getAuthenticationToken();
+        return pending.equals(token);
+    }
+
+    public static void setForceIsTrustedIntentForTesting(boolean isTrusted) {
+        sForcedIncognitoModeForTesting = isTrusted;
+        ResettersForTesting.register(() -> sForcedIncognitoModeForTesting = false);
     }
 }
