+package app.vanadium.ext.utils;
+
+import android.content.Context;
+import android.content.pm.FeatureInfo;
+import android.content.pm.PackageManager;
+
+import org.jspecify.annotations.NullMarked;
+import org.jspecify.annotations.Nullable;
+
+import java.util.HashMap;
+import java.util.Map;
+
+// Meant to be standalone, and avoids chromium source code dependency as much as possible
+@NullMarked
+@SuppressWarnings("NoAndroidLog")
+public class FeatureInfoMapCache {
+
+    private static final Map<String, FeatureInfo> sFeatureInfoMap = new HashMap<>();
+
+    private static final Object sFeatureInfoMapLock = new Object();
+
+    public static void init(Context ctx) {
+        synchronized (sFeatureInfoMapLock) {
+            PackageManager pm = ctx.getPackageManager();
+            FeatureInfo[] featureInfos = pm.getSystemAvailableFeatures();
+            for (FeatureInfo featureInfo: featureInfos) {
+                sFeatureInfoMap.put(featureInfo.name, featureInfo);
+            }
+        }
+    }
+
+    @Nullable
+    public static FeatureInfo get(String name) {
+        synchronized (sFeatureInfoMapLock) {
+            return sFeatureInfoMap.get(name);
+        }
+    }
+}
