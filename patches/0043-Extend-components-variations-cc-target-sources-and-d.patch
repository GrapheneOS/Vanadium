Subject: [PATCH] Extend //components/variations cc target sources and deps

---
 components/variations/service/BUILD.gn        |  5 ++++
 .../service/services_cc_ext_deps.gni          | 26 +++++++++++++++++++
 .../service/services_cc_ext_sources.gni       | 26 +++++++++++++++++++
 3 files changed, 57 insertions(+)
 create mode 100644 vanadium/chromium_src/components/variations/service/services_cc_ext_deps.gni
 create mode 100644 vanadium/chromium_src/components/variations/service/services_cc_ext_sources.gni

diff --git a/components/variations/service/BUILD.gn b/components/variations/service/BUILD.gn
index 47b25b15587c0..88c56d636b83e 100644
--- a/components/variations/service/BUILD.gn
+++ b/components/variations/service/BUILD.gn
@@ -78,6 +78,11 @@ static_library("service") {
     "//services/network/public/cpp",
     "//ui/base",
   ]
+
+  import("//vanadium/chromium_src/components/variations/service/services_cc_ext_sources.gni")
+  sources += services_cc_ext_sources
+  import("//vanadium/chromium_src/components/variations/service/services_cc_ext_deps.gni")
+  deps += services_cc_ext_deps
 }
 
 source_set("unit_tests") {
diff --git a/vanadium/chromium_src/components/variations/service/services_cc_ext_deps.gni b/vanadium/chromium_src/components/variations/service/services_cc_ext_deps.gni
