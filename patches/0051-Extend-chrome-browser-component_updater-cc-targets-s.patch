diff --git a/chrome/browser/component_updater/BUILD.gn b/chrome/browser/component_updater/BUILD.gn
index 05a9c1c03faf2..be48add03b09a 100644
--- a/chrome/browser/component_updater/BUILD.gn
+++ b/chrome/browser/component_updater/BUILD.gn
@@ -103,6 +103,11 @@ source_set("component_updater") {
   if (safe_browsing_mode != 0) {
     public += [ "file_type_policies_component_installer.h" ]
   }
+
+  import("//vanadium/chromium_src/chrome/browser/component_updater/component_updater_cc_ext_public.gni")
+  public += component_updater_cc_ext_public
+  import("//vanadium/chromium_src/chrome/browser/component_updater/component_updater_cc_ext_public_deps.gni")
+  public_deps += component_updater_cc_ext_public_deps
 }
 
 # Implementation target. Only .cc/.mm files.
@@ -285,6 +290,11 @@ source_set("impl") {
   if (is_chrome_for_testing) {
     deps += [ "//chrome/browser/chrome_for_testing:browser" ]
   }
+
+  import("//vanadium/chromium_src/chrome/browser/component_updater/component_updater_impl_cc_ext_sources.gni")
