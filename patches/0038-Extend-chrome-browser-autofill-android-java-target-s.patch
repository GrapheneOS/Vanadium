diff --git a/chrome/browser/autofill/android/BUILD.gn b/chrome/browser/autofill/android/BUILD.gn
index 8bccfcddc99dd..ef330966cf859 100644
--- a/chrome/browser/autofill/android/BUILD.gn
+++ b/chrome/browser/autofill/android/BUILD.gn
@@ -162,6 +162,15 @@ android_library("java") {
     ":jni_headers",
     "//chrome/browser/ui/autofill:autofill_ai_ui_java_enums",
   ]
+
+  import("//vanadium/chromium_src/chrome/browser/autofill/android/java_ext_sources.gni")
+  sources += java_ext_sources
+  import("//vanadium/chromium_src/chrome/browser/autofill/android/java_ext_deps.gni")
+  deps += java_ext_deps
+  import("//vanadium/chromium_src/chrome/browser/autofill/android/java_ext_srcjar_deps.gni")
+  srcjar_deps += java_ext_srcjar_deps
+  import("//vanadium/chromium_src/chrome/browser/autofill/android/java_ext_public_deps.gni")
+  public_deps += java_ext_public_deps
 }
 
 android_library("test_support_java") {
