+package org.chromium.android_webview.common;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+
+import app.vanadium.config.VanadiumConfParser;
+import app.vanadium.config.proto.VanadiumConfigProto.Flag.FlagType;
+
+@NullMarked
+public final class WebViewCachedFlagsHooks {
+
+    @Nullable
+    public static Boolean isCachedFeatureEnabledFromConfig(String feature) {
+        if (VanadiumConfParser.getFlagsFor(FlagType.DISABLED_FEATURE)
+                .containsKey(feature)) {
+            return false;
+        }
+
+        if (VanadiumConfParser.getFlagsFor(FlagType.ENABLED_FEATURE)
+                .containsKey(feature)) {
+            return true;
+        }
+
+        return null;
+    }
+}
