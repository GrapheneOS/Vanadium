diff --git a/vanadium/chromium_src/chrome/android/java/src/org/chromium/chrome/browser/LaunchIntentDispatcherHooks.java b/vanadium/chromium_src/chrome/android/java/src/org/chromium/chrome/browser/LaunchIntentDispatcherHooks.java
new file mode 100644
index 0000000000000..8b86b257e924e
--- /dev/null
+++ b/vanadium/chromium_src/chrome/android/java/src/org/chromium/chrome/browser/LaunchIntentDispatcherHooks.java
@@ -0,0 +1,21 @@
+// Copyright 2023-2026 GrapheneOS
+// Use of this source code is governed by a GPL-2.0-only style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser;
+
+import android.content.Intent;
+
+import org.chromium.build.annotations.NullMarked;
+
+@NullMarked
+public final class LaunchIntentDispatcherHooks {
+
+    static void maybeModifyActionViewIntents(Intent intent) {
+        if (!Intent.ACTION_VIEW.equals(intent.getAction())) {
+            return;
+        }
+
+        TabPreferencesUtils.maybeModifyNeededIncognitoExtras(intent);
+    }
+}
diff --git a/vanadium/chromium_src/chrome/android/java/src/org/chromium/chrome/browser/TabPreferencesUtils.java b/vanadium/chromium_src/chrome/android/java/src/org/chromium/chrome/browser/TabPreferencesUtils.java
index cbaec1c160825..7b4d8eb277876 100644
--- a/vanadium/chromium_src/chrome/android/java/src/org/chromium/chrome/browser/TabPreferencesUtils.java
+++ b/vanadium/chromium_src/chrome/android/java/src/org/chromium/chrome/browser/TabPreferencesUtils.java
@@ -4,6 +4,8 @@
 
 package org.chromium.chrome.browser;
 
+import android.content.Intent;
+
 import org.chromium.base.shared_preferences.SharedPrefsUtils.SharedPrefsExt;
 import org.chromium.build.annotations.NullMarked;
 
@@ -17,4 +19,25 @@ public final class TabPreferencesUtils {
     public static boolean shouldCloseTabsOnExit() {
         return SharedPrefsExt.CLOSE_TABS_ON_EXIT.get();
     }
+
+    public static boolean shouldOpenLinksInIncognito() {
+        return SharedPrefsExt.OPEN_LINKS_IN_INCOGNITO.get();
+    }
+
+    public static boolean shouldOpenExternalLinksInIncognito(Intent intent) {
+        if (!shouldOpenLinksInIncognito()) {
+            return false;
+        }
+
+        return IntentHandler.hasAnyIncognitoExtra(intent.getExtras());
+    }
+
+
+    public static void maybeModifyNeededIncognitoExtras(Intent intent) {
+        if (!shouldOpenLinksInIncognito()) {
+            return;
+        }
+
+        intent.putExtra(IntentHandler.EXTRA_OPEN_NEW_INCOGNITO_TAB, true);
+    }
 }
