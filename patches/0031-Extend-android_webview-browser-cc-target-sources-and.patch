From: quh4gko8 <88831734+quh4gko8@users.noreply.github.com>
Date: Mon, 13 Mar 2023 08:41:43 +0000
Subject: [PATCH] Extend //android_webview/browser cc target sources and deps

---
 android_webview/browser/BUILD.gn              |  5 ++++
 .../browser/browser_cc_ext_deps.gni           | 26 +++++++++++++++++++
 .../browser/browser_cc_ext_sources.gni        | 26 +++++++++++++++++++
 3 files changed, 57 insertions(+)
 create mode 100644 vanadium/chromium_src/android_webview/browser/browser_cc_ext_deps.gni
 create mode 100644 vanadium/chromium_src/android_webview/browser/browser_cc_ext_sources.gni

diff --git a/android_webview/browser/BUILD.gn b/android_webview/browser/BUILD.gn
index dc54d97ba7504..fff0ea853506e 100644
--- a/android_webview/browser/BUILD.gn
+++ b/android_webview/browser/BUILD.gn
@@ -390,6 +390,11 @@ source_set("browser") {
     deps += [ "//components/spellcheck/browser" ]
   }
 
+ import("//vanadium/chromium_src/android_webview/browser/browser_cc_ext_sources.gni")
+ sources += browser_cc_ext_sources
+ import("//vanadium/chromium_src/android_webview/browser/browser_cc_ext_deps.gni")
+ deps += browser_cc_ext_deps
+
   configs += [ "//v8:external_startup_data" ]
 
   # TODO(crbug.com/40031409): Fix code that adds exit-time destructors and
diff --git a/vanadium/chromium_src/android_webview/browser/browser_cc_ext_deps.gni b/vanadium/chromium_src/android_webview/browser/browser_cc_ext_deps.gni
new file mode 100644
index 0000000000000..866fa812ff11b
--- /dev/null
+++ b/vanadium/chromium_src/android_webview/browser/browser_cc_ext_deps.gni
@@ -0,0 +1,26 @@
+# Copyright 2023-2026 GrapheneOS
+# Use of this source code is governed by a GPL-2.0-only style license that can be
+# found in the LICENSE file.
+
+# Three lines of code for minimizing conflicts in rebasing changes
