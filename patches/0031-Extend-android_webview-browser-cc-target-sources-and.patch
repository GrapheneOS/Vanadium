+# Three lines of code for minimizing conflicts in rebasing changes
+browser_cc_ext_full_path_deps = [
+]
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+browser_cc_ext_rel_path_deps = [
+]
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+browser_cc_ext_deps = [
+]
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+browser_cc_ext_deps += browser_cc_ext_full_path_deps
