@@ -8,6 +8,7 @@ public final class PermissionsHooksRegistry {
             @ContentSettingsType.EnumType int contentSettingsType) {
         return switch (contentSettingsType) {
             case ContentSettingsType.JAVASCRIPT_JIT -> new JavascriptJitPermissionsHooks.PermissionsControllerHooksImpl();
