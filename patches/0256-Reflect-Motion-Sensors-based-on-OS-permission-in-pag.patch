diff --git a/components/permissions/android/downstream/java/src/org/chromium/components/permissions/SensorsPermissionsHooks.java b/components/permissions/android/downstream/java/src/org/chromium/components/permissions/SensorsPermissionsHooks.java
new file mode 100644
index 0000000000000..691c2003c15d8
--- /dev/null
+++ b/components/permissions/android/downstream/java/src/org/chromium/components/permissions/SensorsPermissionsHooks.java
@@ -0,0 +1,59 @@
+package org.chromium.components.permissions;
+
+import android.content.pm.PackageManager;
+import android.os.Process;
+
+import org.chromium.base.ApiCompatibilityUtils;
+import org.chromium.base.ContextUtils;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+
+import app.vanadium.config.VanadiumConfParser;
+import app.vanadium.ext.CustomOSPermissions;
+
+import static app.vanadium.config.proto.VanadiumConfigProto.Flag.FlagType.DISABLED_FEATURE;
+
+@NullMarked
+public class SensorsPermissionsHooks {
+
+    @Nullable
+    private static String getPermissionName() {
+        String featureKey = "CheckOSPermissionForSensorsSiteSettingsPermission";
+        if (VanadiumConfParser.getFlagsFor(DISABLED_FEATURE).containsKey(featureKey)) {
+            return null;
+        }
+
+        return CustomOSPermissions.getSensorsPermissionName();
+    }
+
+    private static boolean isPermissionExistingAndRevoked() {
+        String permission = getPermissionName();
+        if (permission == null) {
+            return false;
+        }
+
+        return ApiCompatibilityUtils.checkPermission(
+                ContextUtils.getApplicationContext(), permission,
+                Process.myPid(), Process.myUid()) != PackageManager.PERMISSION_GRANTED;
+    }
+
+    static final class PermissionsControllerHooksImpl extends PermissionsControllerHooks {
+
+        @Override
+        @Nullable
+        public Boolean treatAsAllowedPageInfoOverride() {
+            if (isPermissionExistingAndRevoked()) {
+                return false;
+            }
+
+            return null;
+        }
+
+        @Override
+        @Nullable
+        public String[] getRequiredPermissions() {
+            String permission = getPermissionName();
+            return permission != null ? new String[] { permission } : null;
+        }
+    }
+}
