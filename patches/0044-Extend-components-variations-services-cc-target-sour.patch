diff --git a/components/variations/BUILD.gn b/components/variations/BUILD.gn
index 10e2aa139ebb5..a045bdb8bce5e 100644
--- a/components/variations/BUILD.gn
+++ b/components/variations/BUILD.gn
@@ -165,6 +165,11 @@ component("variations") {
       "//components/variations/android:variations_seed_jni",
     ]
   }
+
+  import("//vanadium/chromium_src/components/variations/variations_cc_ext_sources.gni")
+  sources += variations_cc_ext_sources
+  import("//vanadium/chromium_src/components/variations/variations_cc_ext_deps.gni")
+  deps += variations_cc_ext_deps
 }
 
 if (is_android) {
