+# Three lines of code for minimizing conflicts in rebasing changes
+language_java_ext_full_path_deps = [
+]
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+language_java_ext_rel_path_deps = [
+]
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+language_java_ext_deps = [
+]
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+language_java_ext_deps += language_java_ext_full_path_deps
+foreach(rel_path, language_java_ext_rel_path_deps) {
+  language_java_ext_deps += [ rebase_path(rel_path) ]
+}
