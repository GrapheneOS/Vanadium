From: quh4gko8 <88831734+quh4gko8@users.noreply.github.com>
Date: Thu, 4 Jun 2026 15:17:21 +0000
Subject: [PATCH] Extend //chrome/browser/language/android java target deps and
 sources

---
 chrome/browser/language/android/BUILD.gn      |  6 +++++
 .../android/language_java_ext_deps.gni        | 26 +++++++++++++++++++
 .../android/language_java_ext_sources.gni     | 26 +++++++++++++++++++
 3 files changed, 58 insertions(+)
 create mode 100644 vanadium/chromium_src/chrome/browser/language/android/language_java_ext_deps.gni
 create mode 100644 vanadium/chromium_src/chrome/browser/language/android/language_java_ext_sources.gni

diff --git a/chrome/browser/language/android/BUILD.gn b/chrome/browser/language/android/BUILD.gn
index 29a3372431cdf..4ba8e00b32418 100644
--- a/chrome/browser/language/android/BUILD.gn
+++ b/chrome/browser/language/android/BUILD.gn
@@ -82,6 +82,12 @@ android_library("java") {
     "//ui/android:ui_full_java",
     "//ui/android:ui_no_recycler_view_java",
   ]
+
+  import("//vanadium/chromium_src/chrome/browser/language/android/language_java_ext_sources.gni")
+  sources += language_java_ext_sources
+  import("//vanadium/chromium_src/chrome/browser/language/android/language_java_ext_deps.gni")
+  deps += language_java_ext_deps
+
   resources_package = "org.chromium.chrome.browser.language"
 }
 
diff --git a/vanadium/chromium_src/chrome/browser/language/android/language_java_ext_deps.gni b/vanadium/chromium_src/chrome/browser/language/android/language_java_ext_deps.gni
new file mode 100644
