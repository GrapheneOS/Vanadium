From: quh4gko8 <88831734+quh4gko8@users.noreply.github.com>
Date: Tue, 19 May 2026 15:14:50 +0000
Subject: [PATCH] Reflect Javascript JIT site settings on page info based on
 memory DCL state

---
 .../permissions/android/downstream/BUILD.gn   |  2 ++
 .../JavascriptJitPermissionsHooks.java        | 36 +++++++++++++++++++
 .../permissions/PermissionsHooksRegistry.java |  1 +
 3 files changed, 39 insertions(+)
 create mode 100644 components/permissions/android/downstream/java/src/org/chromium/components/permissions/JavascriptJitPermissionsHooks.java

diff --git a/components/permissions/android/downstream/BUILD.gn b/components/permissions/android/downstream/BUILD.gn
index d1f4ba2ce9b21..d2d5bb44654ed 100644
--- a/components/permissions/android/downstream/BUILD.gn
+++ b/components/permissions/android/downstream/BUILD.gn
@@ -3,12 +3,14 @@ import("//third_party/jni_zero/jni_zero.gni")
 
 android_library("permissions_deps_java") {
   sources = [
+    "java/src/org/chromium/components/permissions/JavascriptJitPermissionsHooks.java",
     "java/src/org/chromium/components/permissions/PermissionsHooksRegistry.java",
     "java/src/org/chromium/components/permissions/PermissionsControllerHooks.java",
   ]
 
   deps = [
     "//components/content_settings/core/common:content_settings_types_java",
+    "//vanadium/android_config/proto:browser_config_parser_java",
   ]
 
   srcjar_deps = [
diff --git a/components/permissions/android/downstream/java/src/org/chromium/components/permissions/JavascriptJitPermissionsHooks.java b/components/permissions/android/downstream/java/src/org/chromium/components/permissions/JavascriptJitPermissionsHooks.java
new file mode 100644
index 0000000000000..ca2658edaa3a6
--- /dev/null
+++ b/components/permissions/android/downstream/java/src/org/chromium/components/permissions/JavascriptJitPermissionsHooks.java
@@ -0,0 +1,36 @@
+package org.chromium.components.permissions;
+
+import static app.vanadium.config.proto.VanadiumConfigProto.Flag.FlagType.DISABLED_FEATURE;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+
+import app.vanadium.config.VanadiumConfParser;
+import app.vanadium.ext.CustomOSApis;
+
+@NullMarked
+final class JavascriptJitPermissionsHooks {
+
+    private static boolean isMemoryDclRestricted() {
+        String featureKey = "CheckOsConfigsForJavascriptJitSiteSettingsForPermissions";
+        if (VanadiumConfParser.getFlagsFor(DISABLED_FEATURE).containsKey(featureKey)) {
+            return false;
+        }
+
+        Boolean isMemoryDclRestricted = CustomOSApis.isMemoryDclRestricted();
+        return isMemoryDclRestricted != null && isMemoryDclRestricted;
+    }
+
+    static final class PermissionsControllerHooksImpl extends PermissionsControllerHooks {
+
+        @Override
+        @Nullable
+        public Boolean treatAsAllowedPageInfoOverride() {
+            if (isMemoryDclRestricted()) {
+                return false;
+            }
+
+            return null;
+        }
+    }
+}
diff --git a/components/permissions/android/downstream/java/src/org/chromium/components/permissions/PermissionsHooksRegistry.java b/components/permissions/android/downstream/java/src/org/chromium/components/permissions/PermissionsHooksRegistry.java
index 2355c73e1c98c..755aeb0a682d4 100644
--- a/components/permissions/android/downstream/java/src/org/chromium/components/permissions/PermissionsHooksRegistry.java
+++ b/components/permissions/android/downstream/java/src/org/chromium/components/permissions/PermissionsHooksRegistry.java
@@ -7,6 +7,7 @@ public final class PermissionsHooksRegistry {
     public static PermissionsControllerHooks getPermissionsControllerHooks(
             @ContentSettingsType.EnumType int contentSettingsType) {
         return switch (contentSettingsType) {
+            case ContentSettingsType.JAVASCRIPT_JIT -> new JavascriptJitPermissionsHooks.PermissionsControllerHooksImpl();
             default -> PermissionsControllerHooks.getDefaultInstance();
         };
     }
