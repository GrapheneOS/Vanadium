+package app.vanadium.ext;
+
+import android.os.Environment;
+import android.util.Log;
+
+import org.jspecify.annotations.NullMarked;
+import org.jspecify.annotations.Nullable;
+
+import java.lang.reflect.Field;
+import java.lang.reflect.Modifier;
+
+import app.vanadium.ext.utils.reflect.MemberCache;
+
+// Meant to be standalone, and avoids chromium source code dependency as much as possible.
+@NullMarked
+@SuppressWarnings("NoAndroidLog")
+public class CustomOSPermissions {
+
+    private static final String TAG = "cr_CustomOSPermissions";
+
+    private static final class PermissionStringFinalFieldWrapper {
+        private final String fieldName;
+        private final MemberCache<Field> fieldCache;
+
+        private PermissionStringFinalFieldWrapper(String fieldName) {
+            this.fieldName = fieldName;
+            this.fieldCache = MemberCache.of(new MemberCache.Fetcher<>() {
+
+                @Override
+                public Field getMember() throws NoSuchFieldException {
+                    return android.Manifest.permission.class.getDeclaredField(fieldName);
+                }
+
+                @Override
+                public void logOrThrow(ReflectiveOperationException e) {
+                    Log.e(TAG, "", e);
+                }
+            });
+        }
+
+        private @Nullable String invokeRes;
+        private volatile boolean invokeResSet;
+
+        @Nullable
+        private String invoke() {
+            Field field = fieldCache.getMember();
+            if (field == null) {
+                return null;
+            }
+
+            if (field.getType() != String.class) {
+                Log.e(TAG, String.format("unexpected field type for %s", fieldName));
+                return null;
+            }
+
+            if (!Modifier.isFinal(field.getModifiers())) {
+                return null;
+            }
+
+            if (invokeResSet) {
+                return invokeRes;
+            }
+
+            try {
+                String res = (String) field.get(null);
+                invokeRes = res;
+                return res;
+            } catch (IllegalAccessException e) {
+                Log.e(TAG, "", e);
+                return null;
+            } finally {
+                invokeResSet = true;
+            }
+        }
+    }
+
+    private static final PermissionStringFinalFieldWrapper sSensorsPermission =
+            new PermissionStringFinalFieldWrapper("OTHER_SENSORS");
+
+    /**
+     * Retrieves the permission name for sensors permission, if exists.
+     * @return the permission value of sensors permission if exists, null otherwise.
+     */
+    @Nullable
+    public static final String getSensorsPermissionName() {
+        return sSensorsPermission.invoke();
+    }
+}
