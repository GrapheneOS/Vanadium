Subject: [PATCH] Extend //content/public/common cc target sources and deps

---
 content/public/common/BUILD.gn                |  5 ++++
 .../common/common_sources_cc_ext_deps.gni     | 26 +++++++++++++++++++
 .../common/common_sources_cc_ext_sources.gni  | 26 +++++++++++++++++++
 3 files changed, 57 insertions(+)
 create mode 100644 vanadium/chromium_src/content/public/common/common_sources_cc_ext_deps.gni
 create mode 100644 vanadium/chromium_src/content/public/common/common_sources_cc_ext_sources.gni

diff --git a/content/public/common/BUILD.gn b/content/public/common/BUILD.gn
index 804a65521c257..c2f818852db88 100644
--- a/content/public/common/BUILD.gn
+++ b/content/public/common/BUILD.gn
@@ -350,6 +350,11 @@ source_set("common_sources") {
   if (use_clang_profiling_inside_sandbox) {
     sources += [ "profiling_utils.h" ]
   }
+
+  import("//vanadium/chromium_src/content/public/common/common_sources_cc_ext_sources.gni")
+  sources += common_sources_cc_ext_sources
+  import("//vanadium/chromium_src/content/public/common/common_sources_cc_ext_deps.gni")
+  deps += common_sources_cc_ext_deps
 }
 
 mojom("interfaces") {
