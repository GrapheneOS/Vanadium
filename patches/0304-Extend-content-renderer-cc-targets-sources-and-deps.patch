From: quh4gko8 <88831734+quh4gko8@users.noreply.github.com>
Date: Wed, 12 Aug 2026 16:38:16 +0000
Subject: [PATCH] Extend //content/renderer cc targets sources and deps

---
 content/renderer/BUILD.gn                     |  4 +++
 .../renderer/renderer_sources_cc_ext_deps.gni | 26 +++++++++++++++++++
 .../renderer_sources_cc_ext_sources.gni       | 26 +++++++++++++++++++
 3 files changed, 56 insertions(+)
 create mode 100644 vanadium/chromium_src/content/renderer/renderer_sources_cc_ext_deps.gni
 create mode 100644 vanadium/chromium_src/content/renderer/renderer_sources_cc_ext_sources.gni

diff --git a/content/renderer/BUILD.gn b/content/renderer/BUILD.gn
index d75dcd39ed891..ba2e790da35dc 100644
--- a/content/renderer/BUILD.gn
+++ b/content/renderer/BUILD.gn
@@ -422,6 +422,10 @@ target(link_target_type, "renderer") {
   if (enable_ipc_fuzzer) {
     configs += [ "//tools/ipc_fuzzer:ipc_fuzzer_config" ]
   }
+  import("//vanadium/chromium_src/content/renderer/renderer_sources_cc_ext_deps.gni")
+  deps += renderer_sources_cc_ext_deps
+  import("//vanadium/chromium_src/content/renderer/renderer_sources_cc_ext_sources.gni")
+  sources += renderer_sources_cc_ext_sources
 }
 
 # See comment at the top of //content/BUILD.gn for how this works.
diff --git a/vanadium/chromium_src/content/renderer/renderer_sources_cc_ext_deps.gni b/vanadium/chromium_src/content/renderer/renderer_sources_cc_ext_deps.gni
new file mode 100644
index 0000000000000..5eba1fab56f39
--- /dev/null
+++ b/vanadium/chromium_src/content/renderer/renderer_sources_cc_ext_deps.gni
@@ -0,0 +1,26 @@
+# Copyright 2023-2026 GrapheneOS
+# Use of this source code is governed by a GPL-2.0-only style license that can be
+# found in the LICENSE file.
+
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+renderer_sources_cc_ext_full_path_deps = [
+]
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+renderer_sources_cc_ext_rel_path_deps = [
+]
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+renderer_sources_cc_ext_deps = [
+]
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+renderer_sources_cc_ext_deps += renderer_sources_cc_ext_full_path_deps
+foreach(rel_path, renderer_sources_cc_ext_rel_path_deps) {
+  renderer_sources_cc_ext_deps += [ rebase_path(rel_path) ]
+}
diff --git a/vanadium/chromium_src/content/renderer/renderer_sources_cc_ext_sources.gni b/vanadium/chromium_src/content/renderer/renderer_sources_cc_ext_sources.gni
new file mode 100644
index 0000000000000..ce1fc62ed8ce6
--- /dev/null
+++ b/vanadium/chromium_src/content/renderer/renderer_sources_cc_ext_sources.gni
@@ -0,0 +1,26 @@
+# Copyright 2023-2026 GrapheneOS
+# Use of this source code is governed by a GPL-2.0-only style license that can be
+# found in the LICENSE file.
+
+# Three lines of code for minimizing conflicts in rebasing changes
