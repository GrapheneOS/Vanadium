Subject: [PATCH] Reflect changes for removed settings in search

---
 .../search/SettingsSearchCoordinator.java     |   6 +
 .../android/chrome_java_ext_sources.gni       |   1 +
 .../search/SearchIndexProviderHooks.java      | 138 ++++++++++++++++++
 3 files changed, 145 insertions(+)
 create mode 100644 vanadium/chromium_src/chrome/android/java/src/org/chromium/chrome/browser/settings/search/SearchIndexProviderHooks.java

diff --git a/chrome/android/java/src/org/chromium/chrome/browser/settings/search/SettingsSearchCoordinator.java b/chrome/android/java/src/org/chromium/chrome/browser/settings/search/SettingsSearchCoordinator.java
index 89c6d58897b21..e060df599e908 100644
--- a/chrome/android/java/src/org/chromium/chrome/browser/settings/search/SettingsSearchCoordinator.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/settings/search/SettingsSearchCoordinator.java
@@ -710,6 +710,8 @@ public class SettingsSearchCoordinator
             } else {
                 provider.updateDynamicPreferences(context, indexData);
             }
+
+            SearchIndexProviderHooks.updateDynamicPreferences(context, provider, indexData);
         }
 
         // Some exceptions whose dynamic preferences cannot be updated via SearchIndexProvider
@@ -734,6 +736,10 @@ public class SettingsSearchCoordinator
             List<SearchIndexProvider> providers) {
         Map<String, SearchIndexProvider> providerMap = new HashMap<>();
         for (SearchIndexProvider provider : providers) {
+            if (SearchIndexProviderHooks.shouldSkipProvider(provider)) {
+                continue;
+            }
+
             providerMap.put(provider.getPrefFragmentName(), provider);
         }
         return providerMap;
