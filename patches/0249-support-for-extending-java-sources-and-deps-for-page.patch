diff --git a/components/page_info/android/BUILD.gn b/components/page_info/android/BUILD.gn
index 7eef20f131faf..873bf51e20b79 100644
--- a/components/page_info/android/BUILD.gn
+++ b/components/page_info/android/BUILD.gn
@@ -135,6 +135,11 @@ android_library("java") {
     "//url:gurl_java",
   ]
 
+  import("page_info_android_java_ext_sources.gni")
+  sources += page_info_android_java_ext_sources
+  import("page_info_android_java_ext_deps.gni")
+  deps += page_info_android_java_ext_deps
+
   resources_package = "org.chromium.components.page_info"
 }
 
