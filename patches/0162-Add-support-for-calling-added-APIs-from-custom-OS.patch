+package app.vanadium.ext;
+
+import android.os.Environment;
+import android.util.Log;
+
+import java.lang.reflect.InvocationTargetException;
+import java.lang.reflect.Method;
+
+import app.vanadium.ext.utils.reflect.MethodCache;
+
+public class CustomOSApis {
+
+    private static final String TAG = "cr_CustomOSApis";
+
+    private static final class BoolEnvMethodCacheWrapper
+            implements MethodCache.Fetcher {
+
+        private final MethodCache mMethodCache;
+        private final String mMethodName;
+
+        BoolEnvMethodCacheWrapper(String methodName) {
+            mMethodName = methodName;
+            mMethodCache = MethodCache.of(this);
+        }
+
+        @Override
+        public Method getMethod() throws NoSuchMethodException {
+            return Environment.class.getDeclaredMethod(mMethodName);
+        }
+
+        @Override
+        public void logOrThrowMethodFetching(Throwable e) {
+            Log.e(TAG, "", e);
+        }
+
+        private Boolean invoke() {
+            try {
+                Method method = mMethodCache.getMethod();
+                return method != null ? (Boolean) method.invoke(null) : null;
+            } catch (IllegalAccessException | InvocationTargetException e) {
+                Log.e(TAG, "", e);
+                return null;
+            }
+        }
+    }
+
+    private static final BoolEnvMethodCacheWrapper sIsExecmemBlockedMethodCache =
+            new BoolEnvMethodCacheWrapper("isExecmemBlocked");
+
+    /**
+     * Checks if execmem is blocked in current process. Method obsoleted since 2026050400 release.
+     * @return true or false if method exists and returns boolean type, null otherwise.
+     */
+    public static Boolean isExecmemBlocked() {
+        return sIsExecmemBlockedMethodCache.invoke();
+    }
+
+    private static final BoolEnvMethodCacheWrapper sIsMemoryDclRestrictedMethodCache =
+            new BoolEnvMethodCacheWrapper("isMemoryDclRestricted");
+
+    /**
+     * Checks if memory DCL is restricted. Method added since 2026050400 release.
+     * @return true or false if method exists and returns boolean type, null otherwise.
+     */
+    public static Boolean isMemoryDclRestricted() {
+        return sIsMemoryDclRestrictedMethodCache.invoke();
+    }
+
+    private static final BoolEnvMethodCacheWrapper sIsStorageDclRestrictedMethodCache =
+            new BoolEnvMethodCacheWrapper("isStorageDclRestricted");
+
+    /**
+     * Checks if storage DCL is restricted. Method added since 2026050400 release.
+     * @return true or false if method exists and returns boolean type, null otherwise.
+     */
+    public static Boolean isStorageDclRestricted() {
+        return sIsStorageDclRestrictedMethodCache.invoke();
+    }
+
+    private static final BoolEnvMethodCacheWrapper sIsWebViewDclRestrictedMethodCache =
+            new BoolEnvMethodCacheWrapper("isWebViewDclRestricted");
+
+    /**
+     * Checks if DCL is restricted in webview. Method added since 2026050400 release.
+     * @return true or false if method exists and returns boolean type, null otherwise.
+     */
+    public static Boolean isWebViewDclRestricted() {
+        return sIsWebViewDclRestrictedMethodCache.invoke();
+    }
+}
