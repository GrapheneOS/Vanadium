diff --git a/components/webauthn/android/java/src/org/chromium/components/webauthn/AuthenticatorImpl.java b/components/webauthn/android/java/src/org/chromium/components/webauthn/AuthenticatorImpl.java
index 6bea91e06bbd6..5b3372d19c2a4 100644
--- a/components/webauthn/android/java/src/org/chromium/components/webauthn/AuthenticatorImpl.java
+++ b/components/webauthn/android/java/src/org/chromium/components/webauthn/AuthenticatorImpl.java
@@ -362,9 +362,9 @@ public final class AuthenticatorImpl implements Authenticator, AuthenticationCon
 
     private boolean couldSupportConditionalMediation() {
         // START CHANGE downstream: Always route to Android 15's CredMan
-        if (android.os.Build.VERSION.SDK_INT >= android.os.Build.VERSION_CODES.VANILLA_ICE_CREAM) {
-            // Skip GMSCore checks.
-            return true;
+        Boolean isCredmanSupported = isCredmanSupporedOverride();
+        if (isCredmanSupported != null) {
+            return isCredmanSupported;
         }
         // END CHANGE downstream: Always route to Android 15's CredMan
         return GmsCoreUtils.isWebauthnSupported() && isChrome(mWebContents);
@@ -377,9 +377,9 @@ public final class AuthenticatorImpl implements Authenticator, AuthenticationCon
      */
     private boolean hasCredentialBackend() {
         // START CHANGE downstream: Always route to Android 15's CredMan
-        if (android.os.Build.VERSION.SDK_INT >= android.os.Build.VERSION_CODES.VANILLA_ICE_CREAM) {
-            // Skip GMSCore checks.
-            return true;
+        Boolean isCredmanSupported = isCredmanSupporedOverride();
+        if (isCredmanSupported != null) {
+            return isCredmanSupported;
         }
         // END CHANGE downstream: Always route to Android 15's CredMan
         if (isChrome(mWebContents)) {
@@ -389,6 +389,22 @@ public final class AuthenticatorImpl implements Authenticator, AuthenticationCon
                 || CredManSupportProvider.getCredManSupportForWebView() != CredManSupport.DISABLED;
     }
 
+    // START CHANGE downstream: Always route to Android 15's CredMan
+    @Nullable
+    private Boolean isCredmanSupporedOverride() {
+        if (android.os.Build.VERSION.SDK_INT < android.os.Build.VERSION_CODES.VANILLA_ICE_CREAM) {
+            return null;
+        }
+
+        // Skip GMSCore checks.
+        if (isChrome(mWebContents)) {
+            return CredManSupportProvider.getCredManSupport() != CredManSupport.DISABLED;
+        }
+
+        return CredManSupportProvider.getCredManSupportForWebView() != CredManSupport.DISABLED;
+    }
+    // END CHANGE downstream: Always route to Android 15's CredMan
+
     @Override
     public void isUserVerifyingPlatformAuthenticatorAvailable(
             final IsUserVerifyingPlatformAuthenticatorAvailable_Response callback) {
diff --git a/components/webauthn/android/java/src/org/chromium/components/webauthn/cred_man/CredManSupportProvider.java b/components/webauthn/android/java/src/org/chromium/components/webauthn/cred_man/CredManSupportProvider.java
index 7c34e180e73fc..6263f29f8f8ef 100644
--- a/components/webauthn/android/java/src/org/chromium/components/webauthn/cred_man/CredManSupportProvider.java
+++ b/components/webauthn/android/java/src/org/chromium/components/webauthn/cred_man/CredManSupportProvider.java
@@ -66,11 +66,21 @@ public class CredManSupportProvider {
             log(TAG, "Disabled because of Android version.");
             return sCredManSupport;
         }
+        // START CHANGE downstream: Always route to Android 15's CredMan
+        if (getAndroidVersion() >= Build.VERSION_CODES.VANILLA_ICE_CREAM) {
+            return getCredManSupportInnerForBrowser();
+        }
+        // END CHANGE downstream: Always route to Android 15's CredMan
         if (notSkippedBecauseInTests() && hasOldGmsVersion()) {
             sCredManSupport = CredManSupport.DISABLED;
             log(TAG, "Disabled because of old GMS version.");
             return sCredManSupport;
         }
+
+        return getCredManSupportInnerForBrowser();
+    }
+
+    private static @CredManSupport int getCredManSupportInnerForBrowser() {
         if (notSkippedBecauseInTests()
                 && ContextUtils.getApplicationContext().getSystemService(Context.CREDENTIAL_SERVICE)
                         == null) {
