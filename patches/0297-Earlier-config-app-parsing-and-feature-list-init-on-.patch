diff --git a/vanadium/chromium_src/chrome/browser/base/android/java/src/org/chromium/chrome/browser/base/SplitCompatApplicationHooks.java b/vanadium/chromium_src/chrome/browser/base/android/java/src/org/chromium/chrome/browser/base/SplitCompatApplicationHooks.java
new file mode 100644
index 0000000000000..f7d6603b668f5
--- /dev/null
+++ b/vanadium/chromium_src/chrome/browser/base/android/java/src/org/chromium/chrome/browser/base/SplitCompatApplicationHooks.java
@@ -0,0 +1,24 @@
+package org.chromium.chrome.browser.base;
+
+import org.chromium.base.ContextUtils;
+import org.chromium.base.config.VanadiumConfigsUtils;
+import org.chromium.base.library_loader.LibraryProcessType;
+import org.chromium.build.annotations.NonNull;
+
+@NonNull
+public final class SplitCompatApplicationHooks {
+
+    public static void attachBaseContextInBrowserProcess() {
+        assert !ContextUtils.getProcessName().contains(":");
+        VanadiumConfigsUtils.initConfigs(
+                ContextUtils.getApplicationContext(),
+                LibraryProcessType.PROCESS_BROWSER);
+    }
+
+    public static void onCommandLineInitialized() {
+        assert !ContextUtils.getProcessName().contains(":");
+        VanadiumConfigsUtils.applyFlagFromConfigs(
+                ContextUtils.getApplicationContext(),
+                LibraryProcessType.PROCESS_BROWSER);
+    }
+}
