+package app.vanadium.ext.utils.reflect;
+
+import java.lang.reflect.Method;
+
+public final class MethodCache {
+
+    public static MethodCache of(Fetcher Fetcher) {
+        return new MethodCache(Fetcher);
+    }
+
+    public interface Fetcher {
+        Method getMethod() throws ClassNotFoundException, NoSuchMethodException;
+        void logOrThrowMethodFetching(Throwable e);
+    }
+
+    private final Fetcher mFetcher;
+
+    private Method mMethod;
+    private volatile boolean mMethodCached;
+
+    private MethodCache(Fetcher Fetcher) {
+        mFetcher = Fetcher;
+    }
+
+    public Method getMethod() {
+        if (mMethodCached) {
+            return mMethod;
+        }
+
+        try {
+            mMethod = mFetcher.getMethod();
+            return mMethod;
+        } catch (ClassNotFoundException | NoSuchMethodException e) {
+            mFetcher.logOrThrowMethodFetching(e);
+        } finally {
+            mMethodCached = true;
+        }
+
+        return null;
+    }
+}
