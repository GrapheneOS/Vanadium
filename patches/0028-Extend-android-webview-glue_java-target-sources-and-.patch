From: quh4gko8 <88831734+quh4gko8@users.noreply.github.com>
Date: Mon, 8 Jun 2026 10:16:37 +0000
Subject: [PATCH] Extend android webview glue_java target sources and deps

---
 android_webview/glue/BUILD.gn                 |  5 ++++
 .../glue/glue_java_ext_deps.gni               | 26 +++++++++++++++++++
 .../glue/glue_java_ext_sources.gni            | 26 +++++++++++++++++++
 3 files changed, 57 insertions(+)
 create mode 100644 vanadium/chromium_src/android_webview/glue/glue_java_ext_deps.gni
 create mode 100644 vanadium/chromium_src/android_webview/glue/glue_java_ext_sources.gni

diff --git a/android_webview/glue/BUILD.gn b/android_webview/glue/BUILD.gn
index b9de9db9e8238..84484743546de 100644
--- a/android_webview/glue/BUILD.gn
+++ b/android_webview/glue/BUILD.gn
@@ -98,4 +98,9 @@ android_library("glue_java") {
   if (public_android_sdk) {
     sources += [ "java/src/com/android/webview/chromium/WebViewChromiumFactoryProviderForT.java" ]
   }
+
+  import ("//vanadium/chromium_src/android_webview/glue/glue_java_ext_sources.gni")
+  sources += glue_java_ext_sources
+  import ("//vanadium/chromium_src/android_webview/glue/glue_java_ext_deps.gni")
+  deps += glue_java_ext_deps
 }
diff --git a/vanadium/chromium_src/android_webview/glue/glue_java_ext_deps.gni b/vanadium/chromium_src/android_webview/glue/glue_java_ext_deps.gni
new file mode 100644
index 0000000000000..aa7065d0d30c7
--- /dev/null
+++ b/vanadium/chromium_src/android_webview/glue/glue_java_ext_deps.gni
@@ -0,0 +1,26 @@
+# Copyright 2023-2026 GrapheneOS
+# Use of this source code is governed by a GPL-2.0-only style license that can be
+# found in the LICENSE file.
+
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+glue_java_ext_full_path_deps = [
+]
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+glue_java_ext_rel_path_deps = [
+]
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+glue_java_ext_deps = [
+]
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+glue_java_ext_deps += glue_java_ext_full_path_deps
+foreach(rel_path, glue_java_ext_rel_path_deps) {
+  glue_java_ext_deps += [ rebase_path(rel_path) ]
+}
diff --git a/vanadium/chromium_src/android_webview/glue/glue_java_ext_sources.gni b/vanadium/chromium_src/android_webview/glue/glue_java_ext_sources.gni
new file mode 100644
