diff --git a/vanadium/chromium_src/components/permissions/android/ext/java/src/org/chromium/components/permissions/PermissionsControllerHooks.java b/vanadium/chromium_src/components/permissions/android/ext/java/src/org/chromium/components/permissions/PermissionsControllerHooks.java
new file mode 100644
index 0000000000000..805dddbdaee9e
--- /dev/null
+++ b/vanadium/chromium_src/components/permissions/android/ext/java/src/org/chromium/components/permissions/PermissionsControllerHooks.java
@@ -0,0 +1,32 @@
+package org.chromium.components.permissions;
+
+import org.chromium.build.annotations.NonNull;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+
+@NullMarked
+public class PermissionsControllerHooks {
+
+    private static final class LazyHolder {
+        @NonNull
+        private static final PermissionsControllerHooks INSTANCE =
+                new PermissionsControllerHooks();
+    }
+
+    @NonNull
+    static PermissionsControllerHooks getDefaultInstance() {
+        return LazyHolder.INSTANCE;
+    }
+
+    public final boolean isDefaultInstance() {
+        return getDefaultInstance() == this;
+    }
+
+    public @Nullable Boolean treatAsAllowedPageInfoOverride() {
+        return null;
+    }
+
+    public String @Nullable [] getRequiredPermissions() {
+        return null;
+    }
+}
diff --git a/vanadium/chromium_src/components/permissions/android/ext/java/src/org/chromium/components/permissions/PermissionsHooksRegistry.java b/vanadium/chromium_src/components/permissions/android/ext/java/src/org/chromium/components/permissions/PermissionsHooksRegistry.java
new file mode 100644
index 0000000000000..26c251271cd90
--- /dev/null
+++ b/vanadium/chromium_src/components/permissions/android/ext/java/src/org/chromium/components/permissions/PermissionsHooksRegistry.java
@@ -0,0 +1,15 @@
+package org.chromium.components.permissions;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.components.content_settings.ContentSettingsType;
+
+@NullMarked
+public final class PermissionsHooksRegistry {
+
+    public static PermissionsControllerHooks getPermissionsControllerHooks(
+            @ContentSettingsType.EnumType int contentSettingsType) {
+        return switch (contentSettingsType) {
+            default -> PermissionsControllerHooks.getDefaultInstance();
+        };
+    }
+}
