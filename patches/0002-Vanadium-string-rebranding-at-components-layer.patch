        sed -ri 's/\b(Google )?Chrom(e|ium)\b/Vanadium/g' "${grdp_files[@]}"
        xtb_dirs=(
            chrome/android/features/tab_ui/java/strings/translations
            chrome/app/resources
            chrome/browser/keyboard_accessory/android/internal/java/strings/translations
