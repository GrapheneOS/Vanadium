            components/permissions/android/translations
            components/policy/resources
            components/strings
            components/webapps/browser/android/translations
            ui/android/java/strings/translations
        )
        find "${xtb_dirs[@]}" -name '*.xtb' -exec sed -ri 's/\b(Google )?Chrom(e|ium)\b/Vanadium/g' {} +
