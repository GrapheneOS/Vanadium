         verify(mInputMethodManagerWrapper, never()).showSoftInput(any(), anyInt(), any());
@@ -1112,4 +1116,83 @@ public class ImeAdapterImplTest {
         adapter.destroyFromNative();
         verify(mEventForwarder).removeTouchSequenceObserver(adapter);
