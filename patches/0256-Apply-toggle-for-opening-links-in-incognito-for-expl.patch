From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: vanadium-staging <107577710+vanadium-staging@users.noreply.github.com>
Date: Sat, 29 Nov 2025 16:43:14 +0000
Subject: [PATCH] Apply toggle for opening links in incognito for explicit
 intents

Changes since:
  - 156.0.8078.79.0
    - Simplify hooks to better indicate intent modification.
---
 .../chrome/browser/ChromeTabbedActivity.java  |  4 ++++
 .../browser/LaunchIntentDispatcher.java       |  2 ++
 .../browser/LaunchIntentDispatcherHooks.java  | 23 +++++++++++++++++++
 3 files changed, 29 insertions(+)

diff --git a/chrome/android/java/src/org/chromium/chrome/browser/ChromeTabbedActivity.java b/chrome/android/java/src/org/chromium/chrome/browser/ChromeTabbedActivity.java
index 1be793404a276..24ca44bc5680c 100644
--- a/chrome/android/java/src/org/chromium/chrome/browser/ChromeTabbedActivity.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/ChromeTabbedActivity.java
@@ -1956,6 +1956,8 @@ public class ChromeTabbedActivity extends ChromeActivity implements PreAttachInt
                 return;
             }
 
+            LaunchIntentDispatcherHooks.maybeModifyMainOrExplicitIntents(intent);
+
             // The intent to use in maybeDispatchExplicitMainViewIntent(). We're explicitly
             // adding NEW_TASK flag to make sure backing from CCT brings up the caller activity,
             // and not Chrome
@@ -2493,6 +2495,8 @@ public class ChromeTabbedActivity extends ChromeActivity implements PreAttachInt
             Log.i(TAG, "#initializeState");
             Intent intent = getIntent();
 
+            LaunchIntentDispatcherHooks.maybeModifyMainOrExplicitIntents(intent);
+
             boolean hadCipherData = false;
             PersistableBundle persistentState = getPersistentInstanceState();
             if (shouldPersistAcrossReboots() && persistentState != null) {
diff --git a/chrome/android/java/src/org/chromium/chrome/browser/LaunchIntentDispatcher.java b/chrome/android/java/src/org/chromium/chrome/browser/LaunchIntentDispatcher.java
index 494445f8471a5..94351d83fe1fb 100644
--- a/chrome/android/java/src/org/chromium/chrome/browser/LaunchIntentDispatcher.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/LaunchIntentDispatcher.java
@@ -565,6 +565,8 @@ public class LaunchIntentDispatcher {
                 newIntent.setFlags(newIntent.getFlags() & ~Intent.FLAG_ACTIVITY_LAUNCH_ADJACENT);
             }
             maybePutCallingAppPackage(newIntent);
+        } else {
+            LaunchIntentDispatcherHooks.maybeModifyMainOrExplicitIntents(newIntent);
         }
 
         if (mActivity instanceof ChromeLauncherActivity) {
diff --git a/vanadium/chromium_src/chrome/android/java/src/org/chromium/chrome/browser/LaunchIntentDispatcherHooks.java b/vanadium/chromium_src/chrome/android/java/src/org/chromium/chrome/browser/LaunchIntentDispatcherHooks.java
index 91ca09d912842..955df94e3f0fb 100644
--- a/vanadium/chromium_src/chrome/android/java/src/org/chromium/chrome/browser/LaunchIntentDispatcherHooks.java
+++ b/vanadium/chromium_src/chrome/android/java/src/org/chromium/chrome/browser/LaunchIntentDispatcherHooks.java
@@ -6,6 +6,7 @@ package org.chromium.chrome.browser;
 
 import android.content.Intent;
 
+import org.chromium.base.IntentUtils;
 import org.chromium.build.annotations.NullMarked;
 
 @NullMarked
@@ -36,4 +37,26 @@ public final class LaunchIntentDispatcherHooks {
         TabPreferencesUtils.maybeModifyNeededIncognitoExtras(intent);
 
     }
+
+    static void maybeModifyMainOrExplicitIntents(Intent intent) {
+        if (intent == null) {
+            return;
+        }
+
+        String urlFromIntent = IntentHandler.getUrlFromIntent(intent);
+        if (urlFromIntent == null) {
+            return;
+        }
+
+        if (IntentUtils.isTrustedIntentFromSelf(intent)) {
+            return;
+        }
+
+        if (intent.getComponent() == null
+                && !Intent.ACTION_MAIN.equals(intent.getAction())) {
+            return;
+        }
+
+        TabPreferencesUtils.maybeModifyNeededIncognitoExtras(intent);
+    }
 }
