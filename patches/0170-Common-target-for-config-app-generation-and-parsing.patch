+# Use of this source code is governed by a GPL-2.0-only style license that can be
+# found in the LICENSE file.
+
+import("//build/config/android/rules.gni")
+
+java_library("common_config_constants_java") {
+  supports_android = true
+  sources = [
+    "java/src/app/vanadium/config/common/Constants.java",
+  ]
+}
diff --git a/vanadium/android_config/common/java/src/app/vanadium/config/common/Constants.java b/vanadium/android_config/common/java/src/app/vanadium/config/common/Constants.java
new file mode 100644
index 0000000000000..920148bc2eb52
--- /dev/null
+++ b/vanadium/android_config/common/java/src/app/vanadium/config/common/Constants.java
@@ -0,0 +1,9 @@
+package app.vanadium.config.common;
+
+public interface Constants {
+
+    interface CheckOsConfigsFeatures {
+        String ISOLATED_PROCESS_V1 = "CheckOsConfigsForIsolatedProcessV1";
+        String ISOLATED_PROCESS_V2 = "CheckOsConfigsForIsolatedProcessV2";
+    }
+}
