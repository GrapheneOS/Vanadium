diff --git a/vanadium/android_config/parser/java/src/app/vanadium/config/SubresourceFilterComponentUtils.java b/vanadium/android_config/parser/java/src/app/vanadium/config/SubresourceFilterComponentUtils.java
new file mode 100644
index 0000000000000..2c12683045c2d
--- /dev/null
+++ b/vanadium/android_config/parser/java/src/app/vanadium/config/SubresourceFilterComponentUtils.java
@@ -0,0 +1,90 @@
+package app.vanadium.config;
+
+import android.content.Context;
+import android.system.ErrnoException;
+import android.util.Log;
+
+import org.jspecify.annotations.NullMarked;
+import org.jspecify.annotations.Nullable;
+
+import java.io.InterruptedIOException;
+import java.util.Objects;
+
+import app.vanadium.ext.utils.AtomicFile2;
+
+import static app.vanadium.config.proto.VanadiumConfigProto.Component.ComponentType.SUBRESOURCE_FILTER_TOOLS;
+
+// Meant to be standalone, and avoids chromium source code dependency as much as possible.
+@NullMarked
+@SuppressWarnings("NoAndroidLog")
+public final class SubresourceFilterComponentUtils {
+
+    private static final String UNINDEXED_RULESET_FILE_NAME = "unindexed_subresource_filter";
+    private static final String TAG = "cr_SubresourceFilterComponentUtils";
+
+    private static @Nullable SubresourceFilterComponentUtils instance;
+    private static volatile boolean initialized;
+
+    private final AtomicFile2 atomicFileForParsing;
+
+    SubresourceFilterComponentUtils(Context appCtx) {
+        this.atomicFileForParsing = new AtomicFile2(appCtx, UNINDEXED_RULESET_FILE_NAME);
+    }
+
+    static @Nullable SubresourceFilterComponentUtils initialize(Context appCtx) {
+        if (initialized) {
+            return instance;
+        }
+
+        instance = new SubresourceFilterComponentUtils(appCtx);
+        initialized = true;
+        return instance;
+    }
+
+    private static @Nullable SubresourceFilterComponentUtils getInstance() {
+        if (!initialized || instance == null) {
+            Log.w(TAG, "not yet initialized", new Throwable());
+            return null;
+        }
+
+        return instance;
+    }
+
+    public static void writeCurrentContents() {
+        SubresourceFilterComponentUtils instance = getInstance();
+        if (instance == null) {
+            return;
+        }
+
+        try {
+            byte[] componentBytes =
+                    VanadiumConfParser.getByteArrayForComponent(
+                            SUBRESOURCE_FILTER_TOOLS);
+            if (componentBytes == null) {
+                return;
+            }
+
+            instance.atomicFileForParsing.write(componentBytes);
+        } catch (ErrnoException | InterruptedIOException e) {
+            Log.e(TAG, "", e);
+        }
+    }
+
+    public static boolean deleteComponentFileForParsing() {
+        SubresourceFilterComponentUtils instance = getInstance();
+        if (instance == null) {
+            return false;
+        }
+
+        return instance.atomicFileForParsing.delete();
+    }
+
+    public static @Nullable String getFilePathForParsing() {
+        SubresourceFilterComponentUtils instance = getInstance();
+        if (instance == null) {
+            return null;
+        }
+
+        return instance.atomicFileForParsing.filePath;
+    }
+}
diff --git a/vanadium/android_config/parser/java/src/app/vanadium/config/VanadiumConfParser.java b/vanadium/android_config/parser/java/src/app/vanadium/config/VanadiumConfParser.java
index 20bb320d564ac..35a85d2e221ad 100644
--- a/vanadium/android_config/parser/java/src/app/vanadium/config/VanadiumConfParser.java
+++ b/vanadium/android_config/parser/java/src/app/vanadium/config/VanadiumConfParser.java
@@ -333,6 +333,9 @@ public final class VanadiumConfParser {
     private static void parseInBackground(Context ctx, SpecType specType) {
         futureParsedConfigs = executor.submit(() -> {
             parsedConfigs = parse(ctx, specType);
+            if (parsedConfigs != null) {
+                SubresourceFilterComponentUtils.initialize(ctx);
+            }
             return parsedConfigs;
         });
     }
