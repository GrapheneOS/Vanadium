diff --git a/vanadium/chromium_src/content/public/android/content_java_group_ext_deps.gni b/vanadium/chromium_src/content/public/android/content_java_group_ext_deps.gni
index 23bfba5c5ed61..dcdc90a04728a 100644
--- a/vanadium/chromium_src/content/public/android/content_java_group_ext_deps.gni
+++ b/vanadium/chromium_src/content/public/android/content_java_group_ext_deps.gni
@@ -6,6 +6,7 @@
 # Three lines of code for minimizing conflicts in rebasing changes
 # Three lines of code for minimizing conflicts in rebasing changes
 content_java_group_ext_full_path_deps = [
+  "//vanadium/chromium_src/content/public/ext/android:feature_map_java",
 ]
 # Three lines of code for minimizing conflicts in rebasing changes
 # Three lines of code for minimizing conflicts in rebasing changes
diff --git a/vanadium/chromium_src/content/public/common/common_sources_cc_ext_deps.gni b/vanadium/chromium_src/content/public/common/common_sources_cc_ext_deps.gni
index dbf7a520e11b9..26d1ae6a0fa19 100644
--- a/vanadium/chromium_src/content/public/common/common_sources_cc_ext_deps.gni
+++ b/vanadium/chromium_src/content/public/common/common_sources_cc_ext_deps.gni
@@ -10,6 +10,14 @@ common_sources_cc_ext_full_path_deps = [
 # Three lines of code for minimizing conflicts in rebasing changes
 # Three lines of code for minimizing conflicts in rebasing changes
 # Three lines of code for minimizing conflicts in rebasing changes
+if (is_android) {
+  common_sources_cc_ext_full_path_deps += [
+    "//vanadium/chromium_src/content/public/ext/android:features",
+  ]
+}
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
 common_sources_cc_ext_rel_path_deps = [
 ]
 # Three lines of code for minimizing conflicts in rebasing changes
diff --git a/vanadium/chromium_src/content/public/ext/android/BUILD.gn b/vanadium/chromium_src/content/public/ext/android/BUILD.gn
new file mode 100644
index 0000000000000..e7f06fb63afaf
--- /dev/null
+++ b/vanadium/chromium_src/content/public/ext/android/BUILD.gn
@@ -0,0 +1,53 @@
+import("//build/config/android/rules.gni")
+import("//third_party/jni_zero/jni_zero.gni")
+
+source_set("features") {
+  sources = [
+    "features.cc",
+    "features.h",
+  ]
+
+  deps = [
+    ":feature_map_jni_headers",
+    "//base",
+  ]
+
+  public_deps = [
+  ]
+}
+
+java_cpp_features("features_srcjar") {
+  # External code should depend on ":features_java" instead.
+  visibility = [ ":*" ]
+  sources = [ "features.cc" ]
+  class_name = "org.chromium.content_public.ContentExtFeatures"
+}
+
+android_library("features_java") {
+  srcjar_deps = [ ":features_srcjar" ]
+}
+
+android_library("feature_map_java") {
+  sources = [
+    "java/src/org/chromium/content_public/ContentExtFeatureList.java",
+    "java/src/org/chromium/content_public/ContentExtFeatureMap.java",
+  ]
+
+  deps = [
+    ":features_java",
+    "//base:base_java",
+    "//build/android:build_java",
+    "//third_party/jni_zero:jni_zero_java",
+  ]
+
+  srcjar_deps = [
+    ":feature_map_jni_headers",
+  ]
+}
+
+generate_jni("feature_map_jni_headers") {
+  visibility = [ ":*" ]
+  sources = [
+    "java/src/org/chromium/content_public/ContentExtFeatureMap.java",
+  ]
+}
diff --git a/vanadium/chromium_src/content/public/ext/android/features.cc b/vanadium/chromium_src/content/public/ext/android/features.cc
new file mode 100644
index 0000000000000..27f3fba8875c0
--- /dev/null
+++ b/vanadium/chromium_src/content/public/ext/android/features.cc
@@ -0,0 +1,33 @@
+#include "vanadium/chromium_src/content/public/ext/android/features.h"
+
+#include "base/android/feature_map.h"
+#include "base/android/jni_android.h"
+#include "base/feature_list.h"
+#include "base/metrics/field_trial_params.h"
+#include "base/no_destructor.h"
+
+#include "vanadium/chromium_src/content/public/ext/android/feature_map_jni_headers/ContentExtFeatureMap_jni.h"
+
+namespace content::android {
+
+namespace {
+
+const base::Feature* const kFeaturesExposedToJava[] = {
+};
+
+// static
+base::android::FeatureMap* GetFeatureMap() {
+  static base::NoDestructor<base::android::FeatureMap> kFeatureMap(
+      kFeaturesExposedToJava);
+  return kFeatureMap.get();
+}
+
+} // namespace
+
+static jlong JNI_ContentExtFeatureMap_GetNativeMap(JNIEnv* env) {
+  return reinterpret_cast<jlong>(GetFeatureMap());
+}
+
+} // namespace content::android
+
+DEFINE_JNI(ContentExtFeatureMap)
