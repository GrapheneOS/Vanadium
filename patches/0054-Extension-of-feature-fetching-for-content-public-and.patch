diff --git a/vanadium/chromium_src/content/public/ext/android/java/src/org/chromium/content_public/ContentExtFeatureList.java b/vanadium/chromium_src/content/public/ext/android/java/src/org/chromium/content_public/ContentExtFeatureList.java
new file mode 100644
index 0000000000000..f21210bd5f0b8
--- /dev/null
+++ b/vanadium/chromium_src/content/public/ext/android/java/src/org/chromium/content_public/ContentExtFeatureList.java
@@ -0,0 +1,16 @@
+package org.chromium.content_public;
+
+import org.chromium.base.MutableFlagWithSafeDefault;
+import org.chromium.base.MutableIntParamWithSafeDefault;
+
+import org.chromium.build.annotations.NonNull;
+import org.chromium.build.annotations.NullMarked;
+
+@NullMarked
+public final class ContentExtFeatureList {
+
+    private static final String TAG = "ContentExtFeatureList";
