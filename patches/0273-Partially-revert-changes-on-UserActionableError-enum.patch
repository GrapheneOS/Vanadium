From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: quh4gko8 <88831734+quh4gko8@users.noreply.github.com>
Date: Tue, 21 Apr 2026 09:27:23 +0000
Subject: [PATCH] Partially revert changes on UserActionableError enums

The change https://chromium-review.googlesource.com/c/chromium/src/+/7772435
removes UserActionableError::{kNeedsSettingsConfirmation,kUnrecoverableError}.

This is used on built-in login database backend which is still enabled
downstream.
---
 components/send_tab_to_self/BUILD.gn                      | 4 ++++
 components/send_tab_to_self/DEPS                          | 5 +++++
 components/send_tab_to_self/entry_point_display_reason.cc | 8 ++++++--
 components/sync/service/BUILD.gn                          | 4 ++++
 components/sync/service/DEPS                              | 3 +++
 components/sync/service/sync_internals_util.cc            | 8 ++++++--
 components/sync/service/sync_service.h                    | 8 ++++++--
 7 files changed, 34 insertions(+), 6 deletions(-)

diff --git a/components/send_tab_to_self/BUILD.gn b/components/send_tab_to_self/BUILD.gn
index 7aaffda6dc6f3..fbba8399403cb 100644
--- a/components/send_tab_to_self/BUILD.gn
+++ b/components/send_tab_to_self/BUILD.gn
@@ -151,4 +151,8 @@ source_set("unit_tests") {
     "//testing/gtest",
     "//url",
   ]
+
+  deps += [
+    "//components/password_manager/core/browser:password_manager_buildflags",
+  ]
 }
diff --git a/components/send_tab_to_self/DEPS b/components/send_tab_to_self/DEPS
index c9557b4482f64..279e73a087c3e 100644
--- a/components/send_tab_to_self/DEPS
+++ b/components/send_tab_to_self/DEPS
@@ -19,3 +19,8 @@ include_rules = [
   "+google_apis",
   "+ui/base",
 ]
+specific_include_rules = {
+  "entry_point_display_reason\\.cc": [
+    "+components/password_manager/core/browser/password_manager_buildflags.h",
+  ],
+}
diff --git a/components/send_tab_to_self/entry_point_display_reason.cc b/components/send_tab_to_self/entry_point_display_reason.cc
index 217810de78514..f0fcab313970e 100644
--- a/components/send_tab_to_self/entry_point_display_reason.cc
+++ b/components/send_tab_to_self/entry_point_display_reason.cc
@@ -16,6 +16,8 @@
 #include "components/sync/service/sync_service.h"
 #include "url/gurl.h"
 
+#include "components/password_manager/core/browser/password_manager_buildflags.h"
+
 namespace send_tab_to_self {
 
 namespace {
@@ -78,10 +80,12 @@ bool HasUserActionableErrorBlockingSendTabToSelf(
     case syncer::SyncService::UserActionableError::
         kNeedsTrustedVaultKeyForEverything:
     case syncer::SyncService::UserActionableError::kNeedsClientUpgrade:
-#if !BUILDFLAG(IS_IOS) && !BUILDFLAG(IS_ANDROID)
+#if !BUILDFLAG(IS_IOS)
+#if BUILDFLAG(USE_LOGIN_DATABASE_AS_BACKEND) || !BUILDFLAG(IS_ANDROID)
     case syncer::SyncService::UserActionableError::kNeedsSettingsConfirmation:
     case syncer::SyncService::UserActionableError::kUnrecoverableError:
-#endif
+#endif // BUILDFLAG(USE_LOGIN_DATABASE_AS_BACKEND) || !BUILDFLAG(IS_ANDROID)
+#endif // !BUILDFLAG(IS_IOS)
 #if BUILDFLAG(IS_IOS)
     case syncer::SyncService::UserActionableError::kDeviceManagementError:
 #endif
diff --git a/components/sync/service/BUILD.gn b/components/sync/service/BUILD.gn
index 60d8dc0f7d68a..42ff46fe62ded 100644
--- a/components/sync/service/BUILD.gn
+++ b/components/sync/service/BUILD.gn
@@ -142,5 +142,9 @@ static_library("service") {
     ]
   }
 
+  deps += [
+    "//components/password_manager/core/browser:password_manager_buildflags",
+  ]
+
   configs += [ "//build/config/compiler:wexit_time_destructors" ]
 }
diff --git a/components/sync/service/DEPS b/components/sync/service/DEPS
index a627fa3392ec3..fa62179ee1cac 100644
--- a/components/sync/service/DEPS
+++ b/components/sync/service/DEPS
@@ -27,6 +27,9 @@ include_rules = [
   "+ui/base/l10n",
 ]
 specific_include_rules = {
+  "sync_(service|internals_util)\\.(cc|h)": [
+    "+components/password_manager/core/browser/password_manager_buildflags.h",
+  ],
   "sync_service_impl_unittest\\.cc": [
     "+components/sync_preferences",
   ],
diff --git a/components/sync/service/sync_internals_util.cc b/components/sync/service/sync_internals_util.cc
index ab59b9b3bb3eb..6858e60c2e9c4 100644
--- a/components/sync/service/sync_internals_util.cc
+++ b/components/sync/service/sync_internals_util.cc
@@ -29,6 +29,8 @@
 #include "components/version_info/version_info.h"
 #include "url/gurl.h"
 
+#include "components/password_manager/core/browser/password_manager_buildflags.h"
+
 namespace syncer::sync_ui_util {
 
 namespace {
@@ -202,12 +204,14 @@ std::string GetUserActionableErrorString(
     case SyncService::UserActionableError::
         kTrustedVaultRecoverabilityDegradedForEverything:
       return "Trusted vault recoverability degraded for everything";
-#if !BUILDFLAG(IS_IOS) && !BUILDFLAG(IS_ANDROID)
+#if !BUILDFLAG(IS_IOS)
+#if BUILDFLAG(USE_LOGIN_DATABASE_AS_BACKEND) || !BUILDFLAG(IS_ANDROID)
     case SyncService::UserActionableError::kNeedsSettingsConfirmation:
       return "Needs settings confirmation";
     case SyncService::UserActionableError::kUnrecoverableError:
       return "Unrecoverable error";
-#endif  // !BUILDFLAG(IS_IOS) && !BUILDFLAG(IS_ANDROID)
+#endif  // !BUILDFLAG(IS_IOS)
+#endif  // BUILDFLAG(USE_LOGIN_DATABASE_AS_BACKEND) || !BUILDFLAG(IS_ANDROID)
 #if BUILDFLAG(IS_ANDROID)
     case SyncService::UserActionableError::kNeedsUPMBackendUpgrade:
       return "Needs UPM backend upgrade";
diff --git a/components/sync/service/sync_service.h b/components/sync/service/sync_service.h
index 4b6a81215bfd9..122b1e25df2d1 100644
--- a/components/sync/service/sync_service.h
+++ b/components/sync/service/sync_service.h
@@ -27,6 +27,8 @@
 #include "base/android/scoped_java_ref.h"
 #endif
 
+#include "components/password_manager/core/browser/password_manager_buildflags.h"
+
 struct CoreAccountInfo;
 class GoogleServiceAuthError;
 class GURL;
@@ -224,7 +226,7 @@ class SyncService : public KeyedService {
     kTrustedVaultRecoverabilityDegradedForEverything = 6,
 // This enum is parsed by java_cpp_enum.py, which doesn't accept &&ing flags.
 #if !BUILDFLAG(IS_IOS)
-#if !BUILDFLAG(IS_ANDROID)
+#if BUILDFLAG(USE_LOGIN_DATABASE_AS_BACKEND) || !BUILDFLAG(IS_ANDROID)
     // Sync settings dialog not confirmed yet.
     kNeedsSettingsConfirmation = 7,
     // Sync has encountered an unrecoverable error. It won't attempt to start
@@ -232,13 +234,15 @@ class SyncService : public KeyedService {
     // and back in again. This error is only shown for syncing users, and will
     // be removed with "Sync The Feature" deprecation.
     kUnrecoverableError = 8,
-#endif  // !BUILDFLAG(IS_ANDROID)
+#endif  // BUILDFLAG(USE_LOGIN_DATABASE_AS_BACKEND) || !BUILDFLAG(IS_ANDROID)
 #endif  // !BUILDFLAG(IS_IOS)
 
+#if BUILDFLAG(USE_LOGIN_DATABASE_AS_BACKEND)
 #if BUILDFLAG(IS_ANDROID)
     // Indicates that the Google Play services need to be upgraded.
     kNeedsUPMBackendUpgrade = 9,
 #endif  // BUILDFLAG(IS_ANDROID)
+#endif  // BUILDFLAG(USE_LOGIN_DATABASE_AS_BACKEND)
 
     // Indicates that the version of the client/browser is too old and needs to
     // be upgraded to a more recent version.
