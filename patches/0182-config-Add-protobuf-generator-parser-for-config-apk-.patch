+++ b/vanadium/android_config/proto/host/java/src/app/vanadium/config/host/ConfigGeneratorImpl.kt
@@ -0,0 +1,299 @@
+package app.vanadium.config.host
+
+import app.vanadium.config.common.Constants.CheckOsConfigsFeatures
+import app.vanadium.config.common.Constants.SystemFeatures
+
+import app.vanadium.config.proto.VanadiumConfigProto.Component
+import app.vanadium.config.proto.VanadiumConfigProto.Component.AdditionalComponent
+import app.vanadium.config.proto.VanadiumConfigProto.Component.ComponentCondition
+import app.vanadium.config.proto.VanadiumConfigProto.Component.ComponentType
+import app.vanadium.config.proto.VanadiumConfigProto.Config
+import app.vanadium.config.proto.VanadiumConfigProto.Configs
+import app.vanadium.config.proto.VanadiumConfigProto.Flag
+import app.vanadium.config.proto.VanadiumConfigProto.Flag.FlagType
+import app.vanadium.config.proto.VanadiumConfigProto.Spec
+import app.vanadium.config.proto.VanadiumConfigProto.Spec.DeviceSupportCondition
+import app.vanadium.config.proto.VanadiumConfigProto.Spec.SpecType
+import app.vanadium.config.proto.VanadiumConfigProto.Spec.SysFeatureCondition
+
+import com.google.protobuf.Internal.EnumLite
+
+import java.io.FileOutputStream
+
+import kotlin.IllegalArgumentException
+import kotlin.Int
+import kotlin.String
+import kotlin.Unit
+import kotlin.run
+
+
+fun main(vararg args: String) {
+    var outFile: String? = null
+    val iter = args.iterator()
+    while (iter.hasNext()) {
+        when (val curArg = iter.next()) {
+            "-o", "--out_file", "--out-file", "-o=", "--out_file=", "--out-file=" -> {
+                if (!iter.hasNext()) {
+                    throw IllegalArgumentException("Missing args for file")
+                }
+                outFile = iter.next()
+                continue
+            }
+
+            else -> {
+                if (curArg.startsWith("-o=")
+                    || curArg.startsWith("--out-file=")
+                    || curArg.startsWith("--out_file=")
+                ) {
+                    outFile = curArg.split("=")[1]
+                    continue
+                }
+                throw IllegalArgumentException("Unrecognized argument")
+            }
+        }
+    }
+
+    if (outFile.isNullOrBlank()) {
+        throw IllegalArgumentException("Missing output file argument")
+    }
+
+    val sortedConfigs = sortConfigs(unsortedConfigs())
+
+    FileOutputStream(outFile).use {
+        sortedConfigs.writeTo(it)
+    }
+}
+
+private fun unsortedConfigs(): List<Config> {
+    val configs = ArrayList<Config>()
+
+    return configs
+}
+
+
+private fun sortConfigs(configList: List<Config>): Configs {
+    return Configs.newBuilder().addAllConfigs(
+        configList.sortedWith { config: Config, otherConfig: Config ->
+            val spec = config.spec
+            val otherSpec = otherConfig.spec
+            val specTypeCmp = spec.specTypes.compareTo(otherSpec.specTypes)
+            if (specTypeCmp != 0) {
+                return@sortedWith specTypeCmp
+            }
+
+            val minVerCmp = spec.minVersion.compareTo(otherSpec.minVersion)
+            if (minVerCmp != 0) {
+                return@sortedWith minVerCmp
+            }
+
+            val maxVerCmp = spec.maxVersion.compareTo(otherSpec.maxVersion)
+            if (maxVerCmp != 0) {
+                return@sortedWith maxVerCmp
+            }
+
+            0
+    }).build()
+}
+
+private fun config(
+    components: List<Component>,
+    flags: List<Flag>,
+    block: Config.Builder.() -> Unit,
+): Config {
+    return Config.newBuilder().run {
+        addAllComponents(components)
+        addAllFlags(flags)
+        block(this)
+        build()
+    }
+}
+
+private fun config(
+    spec: Spec,
+    components: List<Component>,
+    flags: List<Flag>,
+    block: Config.Builder.() -> Unit,
+): Config {
+    return Config.newBuilder().run {
+        setSpec(spec)
+        addAllComponents(components)
+        addAllFlags(flags)
+        block(this)
+        build()
+    }
+}
+
+private fun config(block: Config.Builder.() -> Unit): Config {
+    return Config.newBuilder().run {
+        block(this)
+        build()
+    }
+}
+
+private fun spec(block: Spec.Builder.() -> Unit): Spec {
+    return Spec.newBuilder().run {
+        block(this)
+        build()
+    }
+}
+
+private fun deviceSupportCondition(
+    block: DeviceSupportCondition.Builder.() -> Unit
+): DeviceSupportCondition {
+    return DeviceSupportCondition.newBuilder().run {
+        block(this)
+        build()
+    }
+}
+
+private fun sysFeatureConditions(
+    vararg sysFeatureConditions: SysFeatureCondition
+): List<SysFeatureCondition> {
+    return listOf(*sysFeatureConditions)
+}
+
+private fun sysFeatureCondition(
+    block: SysFeatureCondition.Builder.() -> Unit
+): SysFeatureCondition {
+    return SysFeatureCondition.newBuilder().run {
+        minVersion = SystemFeatures.UNBOUNDED_FEATURE_VERSION
+        maxVersion = SystemFeatures.UNBOUNDED_FEATURE_VERSION
+        block(this)
+        build()
+    }
+}
+
+private fun flags(vararg flags: Flag): List<Flag> {
+    return listOf(*flags)
+}
+
+private fun flag(block: Flag.Builder.() -> Unit): Flag {
+    return Flag.newBuilder().run {
+        block(this)
+        build()
+    }
+}
+
+private fun components(vararg components: Component): List<Component> {
+    return components.toList()
+}
+
+private fun component(block: Component.Builder.() -> Unit): Component {
+    return Component.newBuilder().run {
+        block(this)
+        build()
+    }
+}
+
+private fun additionalComponents(
+    vararg additionalComponents: AdditionalComponent
+): List<AdditionalComponent> {
+    return additionalComponents.toList()
+}
+
+private fun additionalComponent(block: AdditionalComponent.Builder.() -> Unit): AdditionalComponent {
+    return AdditionalComponent.newBuilder().run {
+        block(this)
+        build()
+    }
+}
+
+private fun componentConditions(
+    vararg componentConditions: ComponentCondition
+): List<ComponentCondition> {
+    return componentConditions.toList()
+}
+
+private fun componentCondition(block: ComponentCondition.Builder.() -> Unit): ComponentCondition {
+    return ComponentCondition.newBuilder().run {
+        block(this)
+        build()
+    }
+}
+
+private fun Spec.Builder.specTypes(vararg specTypesList: SpecType) {
+    specTypesWithVersionBounds(specTypesList.toList())
+}
+
+private fun Spec.Builder.specTypesWithVersionBounds(
+    specTypesList: List<SpecType>,
+    minVanadiumVersion: VanadiumVersion? = null,
+    maxVanadiumVersion: VanadiumVersion? = null
+) {
+    specTypes = specTypesListEnum(specTypesList)
+    minVersion = minVanadiumVersion?.toLong() ?: 0L
+    maxVersion = maxVanadiumVersion?.toLong() ?: 0L
+}
+
+private fun specTypesListEnum(specTypes: List<SpecType>): Long {
+    return enumBitsLong(specTypes)
+}
+
+private fun <T : EnumLite> enumBitsLong(enumBits: List<T>): Long {
+    var bits = 0L
+    enumBits.forEach {
+        check(it.number <= 63)
+        bits = bits or (1L shl it.number)
+    }
+    return bits
+}
+
+private fun SysFeatureCondition.Builder.disableForAllGosVersions() {
+    setGosVersionBoundsInner(minVersionLong = Long.MAX_VALUE)
+}
+
+private fun SysFeatureCondition.Builder.setGosVersionBounds(
+    minGosVersion: GrapheneOsVersion? = null,
+    maxGosVersion: GrapheneOsVersion? = null,
+) {
+    setGosVersionBoundsInner(
+        minVersionLong = minGosVersion?.toLong() ?: 0L,
+        maxVersionLong = maxGosVersion?.toLong() ?: 0L
+    )
+}
+
+private fun SysFeatureCondition.Builder.setGosVersionBoundsInner(
+    minVersionLong: Long = 0L,
+    maxVersionLong: Long = 0L,
+) {
+    featureName = SystemFeatures.GRAPHENEOS_VERSION
+    minVersion = minVersionLong
+    maxVersion = maxVersionLong
+}
+
+data class VanadiumVersion(
+    val major: Int,
+    val minor: Int,
+    val archApkVariant: Int = 0
+) {
+    init {
+        check(major > 0)
+        check(minor in 0..999)
+        check(archApkVariant in 0..99)
+    }
+
+    fun toLong() = major * 100_000L + minor * 100L + archApkVariant
+    companion object {
+        fun min() = VanadiumVersion(major = 6261, minor = 43 + 1)
+    }
+}
+
+data class GrapheneOsVersion(
+    val year: Int,
+    val month: Int,
+    val day: Int,
+    val increment: Int = 0
+) {
+    init {
+        check(year > 0)
+        check(month in 1..12)
+        check(day in 1..31)
+        check(increment in 0..100)
+    }
+
+    fun toLong() = year * 1_000_000L + month * 10_000L + day * 100L + increment
+    companion object {
+        // Initial version the config app is included in the OS
+        fun min() = GrapheneOsVersion(year = 2024, month = 2, day = 23)
+    }
+}
