+  requires_android = true
+  deps = [
+    "//vanadium/android_config/common:common_config_constants_java",
+    "//vanadium/android_config/proto:config_proto_java",
+    "//third_party/kotlin_stdlib:kotlin_stdlib_java",
+    "//third_party/android_deps:protobuf_lite_runtime_java",
+  ]
+  # No need to enable checks for unused methods here.
+  enable_errorprone = false
+}
+
+java_binary("proto_config_parser_java") {
+  sources = [
+    "java/src/app/vanadium/config/host/ConfigParser.java",
+  ]
+  deps = [
+    "//vanadium/android_config/proto:config_proto_java",
+    "//third_party/android_deps:protobuf_lite_runtime_java",
+  ]
+  # Needed to be able to compile this as a java binary with python script wrapper, for pb2 generation
