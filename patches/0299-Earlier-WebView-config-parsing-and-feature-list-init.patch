diff --git a/vanadium/chromium_src/android_webview/glue/ext/java/src/com/android/webview/chromium/WebViewChromiumFactoryProviderHooks.java b/vanadium/chromium_src/android_webview/glue/ext/java/src/com/android/webview/chromium/WebViewChromiumFactoryProviderHooks.java
new file mode 100644
index 0000000000000..bb634570c401b
--- /dev/null
+++ b/vanadium/chromium_src/android_webview/glue/ext/java/src/com/android/webview/chromium/WebViewChromiumFactoryProviderHooks.java
@@ -0,0 +1,20 @@
+package com.android.webview.chromium;
+
+import org.chromium.base.ContextUtils;
+import org.chromium.base.config.VanadiumConfigsUtils;
+import org.chromium.base.library_loader.LibraryProcessType;
+
+public class WebViewChromiumFactoryProviderHooks {
+
+    public static void postInitAppContext() {
+        VanadiumConfigsUtils.initConfigs(
+                ContextUtils.getApplicationContext(),
+                LibraryProcessType.PROCESS_WEBVIEW);
+    }
+
+    public static void applyCommandLineChanges() {
+        VanadiumConfigsUtils.applyFlagFromConfigs(
+                ContextUtils.getApplicationContext(),
+                LibraryProcessType.PROCESS_WEBVIEW);
+    }
+}
diff --git a/vanadium/chromium_src/android_webview/glue/glue_java_ext_deps.gni b/vanadium/chromium_src/android_webview/glue/glue_java_ext_deps.gni
