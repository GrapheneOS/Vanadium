diff --git a/android_webview/BUILD.gn b/android_webview/BUILD.gn
index 49f4e5682fdb3..949db3618d442 100644
--- a/android_webview/BUILD.gn
+++ b/android_webview/BUILD.gn
@@ -684,6 +684,11 @@ if (_is_default_toolchain) {
       "//components/safe_browsing/core/browser/db:sb_threat_values",
     ]
 
+    import("//vanadium/chromium_src/android_webview/browser_java_ext_sources.gni")
+    sources += browser_java_ext_sources
+    import("//vanadium/chromium_src/android_webview/browser_java_ext_deps.gni")
+    deps += browser_java_ext_deps
+
     resources_package = "org.chromium.android_webview"
   }
 
@@ -830,6 +835,11 @@ if (_is_default_toolchain) {
       ":common_java_switches_srcjar",
       ":common_jni",
     ]
+
+    import("//vanadium/chromium_src/android_webview/common_java_ext_sources.gni")
+    sources += common_java_ext_sources
+    import("//vanadium/chromium_src/android_webview/common_java_ext_deps.gni")
+    deps += common_java_ext_deps
   }
 
   android_aidl("common_aidl") {
