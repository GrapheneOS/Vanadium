+package org.chromium.components.browser_ui.site_settings;
+
+import android.content.Context;
+import android.content.pm.PackageInfo;
+import android.content.pm.PackageManager;
+import android.net.Uri;
+import android.os.Process;
+
+import androidx.preference.Preference;
+
+import org.chromium.base.ApiCompatibilityUtils;
+import org.chromium.base.ContextUtils;
+import org.chromium.base.PackageUtils;
+import org.chromium.build.annotations.NonNull;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.components.content_settings.ContentSetting;
+import org.chromium.components.content_settings.ContentSettingsType;
+import org.chromium.content_public.browser.BrowserContextHandle;
+import org.chromium.components.embedder_support.util.UrlConstants;
+import org.chromium.components.embedder_support.util.Origin;
+
+import app.vanadium.config.VanadiumConfParser;
+import app.vanadium.ext.CustomOSPermissions;
+
+import java.util.Arrays;
+import java.util.ArrayList;
+import java.util.Collection;
+
+import static app.vanadium.config.proto.VanadiumConfigProto.Flag.FlagType.DISABLED_FEATURE;
+
+@NullMarked
+public final class SensorsSettingsHooks {
+
+    private static boolean isPermissionExistingAndRevoked() {
+        String featureKey = "CheckOSPermissionForSensorsSiteSettingsUI";
+        if (VanadiumConfParser.getFlagsFor(DISABLED_FEATURE).containsKey(featureKey)) {
+            return false;
+        }
+
+        String permission = CustomOSPermissions.getSensorsPermissionName();
+        if (permission == null) {
+            return false;
+        }
+
+        Context appCtx = ContextUtils.getApplicationContext();
+        PackageInfo selfPkgInfo = PackageUtils.getPackageInfo(
+              appCtx.getPackageName(), PackageManager.GET_PERMISSIONS);
+        if (selfPkgInfo == null) {
+            return false;
+        }
+
+        String[] requestedPermissions = selfPkgInfo.requestedPermissions;
+        if (requestedPermissions == null
+                || !Arrays.asList(requestedPermissions).contains(permission)) {
+            return false;
+        }
+
+        return ApiCompatibilityUtils.checkPermission(
+                ContextUtils.getApplicationContext(), permission,
+                Process.myPid(), Process.myUid()) != PackageManager.PERMISSION_GRANTED;
+    }
+
+    static final class CategoryHooksImpl extends SiteSettingsCategoryHooks {
+
+        @Override
+        @NonNull
+        protected SiteSettingsCategory getSiteSettingsCategory(@NonNull BrowserContextHandle bch) {
+            return new SensorsSiteSettingsCategory(bch);
+        }
+    }
+
+    static final class SensorsSiteSettingsCategory extends SiteSettingsCategory {
+
+        SensorsSiteSettingsCategory(@NonNull BrowserContextHandle bch) {
+            super(bch, Type.SENSORS, "");
+        }
+
+        @Override
+        protected boolean enabledForChrome(Context context) {
+            return !isPermissionExistingAndRevoked();
+        }
+
+        @Override
+        protected boolean shouldDisableToggle() {
+            return isPermissionExistingAndRevoked();
+        }
+    }
+    static final class SiteSettingsScreenHooksImpl extends SiteSettingsScreenHooks {
+
+        @Override
+        protected void updateSiteSettingsPreference(
+                @NonNull SiteSettings siteSettingsFragment,
+                @NonNull SiteSettingsDelegate siteSettingsDelegate,
+                @NonNull Preference existingPreference) {
+            if (isPermissionExistingAndRevoked()) {
+                existingPreference.setSummary(ContentSettingsResources.getCategorySummary(
+                        ContentSetting.BLOCK, /* isOneTime= */ false));
+            }
+        }
+    }
+
+    static final class WebsitePermissionsFetcherHooksImpl extends WebsitePermissionsFetcherHooks {
+
+        @Override
+        protected int getPermissionTypeOverride() {
+            return PERMISSION_INFO;
+        }
+
+        @Override
+        protected boolean shouldCreateExceptionIfNull() {
+            return true;
+        }
+    }
+
+    static final class SingleCategorySettingsHooksImpl extends SingleCategorySettingsHooks {
+
+        private static boolean shouldUseRevisedSiteSettingsException() {
+            String featureKey = "MotionSensorsRevisedSiteSettingsException";
+            if (VanadiumConfParser.getFlagsFor(DISABLED_FEATURE)
+                    .containsKey(featureKey)) {
+                return false;
+            }
+
+            return true;
+        }
+
+        @Override
+        @Nullable
+        protected Boolean shouldAddExceptionButton(boolean isCategoryEnabled) {
+            if (isPermissionExistingAndRevoked()) {
+                return false;
+            }
+
+            return shouldUseRevisedSiteSettingsException();
+        }
+
+        @Override
+        @Nullable
+        protected Collection<Website> applyFilters(Collection<Website> sites) {
+            if (!shouldUseRevisedSiteSettingsException()) {
+                return null;
+            }
+
+            Collection<Website> filtered = new ArrayList<>();
+            for (Website site : sites) {
+                if (site.getAddress().getOrigin().startsWith(UrlConstants.HTTPS_URL_PREFIX)) {
+                    filtered.add(site);
+                }
+
+                if (site.getAddress().getOrigin().startsWith(UrlConstants.HTTP_URL_PREFIX)) {
+                    filtered.add(site);
+                }
+            }
+            return filtered;
+        }
+
+        @Override
+        @Nullable
+        protected String maybeModifyPrimaryPattern(String pattern) {
+            if (!shouldUseRevisedSiteSettingsException()) {
+                return null;
+            }
+
+            Origin originFromPattern = Origin.create(pattern);
+            if (originFromPattern == null) {
+                return null;
+            }
+
+            Uri originUri = originFromPattern.uri();
+            String hostStr = originUri.getHost();
+            int port = originUri.getPort();
+            int httpsPort = 443;
+            return UrlConstants.HTTPS_URL_PREFIX + hostStr + ":" + httpsPort;
+        }
+
+        @Override
+        protected int getAddExceptionDialogMessageResourceId(boolean isCategoryEnabled) {
+            return isCategoryEnabled ? R.string.website_settings_add_site_description_motion_sensors_block
+                                     : R.string.website_settings_add_site_description_motion_sensors_allow;
+        }
+
+        @Override
+        protected boolean shouldAlwaysShowOsWarning() {
+            return isPermissionExistingAndRevoked();
+        }
+    }
+
+    static final class SingleWebsiteSettingsHooksImpl extends SingleWebsiteSettingsHooks {
+
+        @Override
+        @Nullable
+        protected PermissionSetting getPermissionSettingForSetup(
+                @NonNull BrowserContextHandle browserContextHandle,
+                @Nullable PermissionSetting setting,
+                @ContentSettingsType.EnumType int contentType) {
+            if (isPermissionExistingAndRevoked()) {
+                return new PermissionSetting(null, ContentSetting.BLOCK, false);
+            }
+            if (setting == null) {
+                boolean isEnabled = WebsitePreferenceBridge.isContentSettingEnabled(browserContextHandle, contentType);
+                int value = isEnabled ? ContentSetting.ALLOW : ContentSetting.BLOCK;
+                return new PermissionSetting(null, value, false);
+            }
+            return setting;
+        }
+
+        @Override
+        protected void setupOrModifyPreference(
+                @NonNull SingleWebsiteSettings siteSettingsFragment,
+                @NonNull BrowserContextHandle browserContextHandle,
+                @NonNull Preference preference) {
+            if (isPermissionExistingAndRevoked()) {
+                preference.setEnabled(false);
+            }
+        }
+    }
+}
