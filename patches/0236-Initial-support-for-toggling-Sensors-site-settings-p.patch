         return switch (categoryType) {
             case SiteSettingsCategory.Type.JAVASCRIPT_JIT -> new JavascriptJitSettingsHooks.SiteSettingsScreenHooksImpl();
+            case SiteSettingsCategory.Type.SENSORS -> new SensorsSettingsHooks.SiteSettingsScreenHooksImpl();
             default -> SiteSettingsScreenHooks.getDefaultInstance();
         };
     }
@@ -60,6 +64,7 @@ public final class SiteSettingsHooksRegistry {
             @ContentSettingsType.EnumType int contentType) {
         return switch (contentType) {
             case ContentSettingsType.JAVASCRIPT_JIT -> new JavascriptJitSettingsHooks.WebsitePermissionsFetcherHooksImpl();
+            case ContentSettingsType.SENSORS -> new SensorsSettingsHooks.WebsitePermissionsFetcherHooksImpl();
             default -> WebsitePermissionsFetcherHooks.getDefaultInstance();
         };
