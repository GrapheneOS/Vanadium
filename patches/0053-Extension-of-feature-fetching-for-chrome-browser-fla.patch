diff --git a/vanadium/chromium_src/chrome/android/chrome_java_ext_deps.gni b/vanadium/chromium_src/chrome/android/chrome_java_ext_deps.gni
index 9640cd7d65af8..55dafeb95ee0c 100644
--- a/vanadium/chromium_src/chrome/android/chrome_java_ext_deps.gni
+++ b/vanadium/chromium_src/chrome/android/chrome_java_ext_deps.gni
@@ -6,6 +6,7 @@
 # Three lines of code for minimizing conflicts in rebasing changes
 # Three lines of code for minimizing conflicts in rebasing changes
 chrome_java_ext_full_path_deps = [
+  "//vanadium/chromium_src/chrome/browser/flags/ext/android:feature_map_java",
 ]
 # Three lines of code for minimizing conflicts in rebasing changes
 # Three lines of code for minimizing conflicts in rebasing changes
diff --git a/vanadium/chromium_src/chrome/browser/android/android_cc_ext_deps.gni b/vanadium/chromium_src/chrome/browser/android/android_cc_ext_deps.gni
index 4b81e601d874a..6c441f06aeda3 100644
--- a/vanadium/chromium_src/chrome/browser/android/android_cc_ext_deps.gni
+++ b/vanadium/chromium_src/chrome/browser/android/android_cc_ext_deps.gni
@@ -6,6 +6,7 @@
 # Three lines of code for minimizing conflicts in rebasing changes
 # Three lines of code for minimizing conflicts in rebasing changes
 android_cc_ext_full_path_deps = [
+  "//vanadium/chromium_src/chrome/browser/flags/ext/android:features",
 ]
 # Three lines of code for minimizing conflicts in rebasing changes
 # Three lines of code for minimizing conflicts in rebasing changes
diff --git a/vanadium/chromium_src/chrome/browser/flags/ext/android/BUILD.gn b/vanadium/chromium_src/chrome/browser/flags/ext/android/BUILD.gn
new file mode 100644
index 0000000000000..5531e5cb9bba4
--- /dev/null
+++ b/vanadium/chromium_src/chrome/browser/flags/ext/android/BUILD.gn
@@ -0,0 +1,53 @@
+import("//build/config/android/rules.gni")
+import("//third_party/jni_zero/jni_zero.gni")
+
+source_set("features") {
+  sources = [
+    "features.cc",
+    "features.h",
+  ]
+
+  deps = [
+    ":feature_map_jni_headers",
+    "//base",
+  ]
+
+  public_deps = [
+  ]
+}
+
+java_cpp_features("features_srcjar") {
+  # External code should depend on ":features_java" instead.
+  visibility = [ ":*" ]
+  sources = [ "features.cc" ]
+  class_name = "org.chromium.chrome.browser.flags.ChromeExtFeatures"
+}
+
+android_library("features_java") {
+  srcjar_deps = [ ":features_srcjar" ]
+}
+
+android_library("feature_map_java") {
+  sources = [
+    "java/src/org/chromium/chrome/browser/flags/ChromeExtFeatureList.java",
+    "java/src/org/chromium/chrome/browser/flags/ChromeExtFeatureMap.java",
+  ]
+
+  deps = [
+    ":features_java",
+    "//base:base_java",
+    "//build/android:build_java",
+    "//third_party/jni_zero:jni_zero_java",
+  ]
+
+  srcjar_deps = [
+    ":feature_map_jni_headers",
+  ]
+}
+
+generate_jni("feature_map_jni_headers") {
+  visibility = [ ":*" ]
+  sources = [
+    "java/src/org/chromium/chrome/browser/flags/ChromeExtFeatureMap.java",
+  ]
+}
diff --git a/vanadium/chromium_src/chrome/browser/flags/ext/android/features.cc b/vanadium/chromium_src/chrome/browser/flags/ext/android/features.cc
new file mode 100644
index 0000000000000..490c12d805a45
--- /dev/null
+++ b/vanadium/chromium_src/chrome/browser/flags/ext/android/features.cc
@@ -0,0 +1,33 @@
+#include "vanadium/chromium_src/chrome/browser/flags/ext/android/features.h"
+
+#include "base/android/feature_map.h"
+#include "base/android/jni_android.h"
+#include "base/feature_list.h"
+#include "base/metrics/field_trial_params.h"
+#include "base/no_destructor.h"
+
+#include "vanadium/chromium_src/chrome/browser/flags/ext/android/feature_map_jni_headers/ChromeExtFeatureMap_jni.h"
+
+namespace chrome::android {
+
+namespace {
+
+const base::Feature* const kFeaturesExposedToJava[] = {
+};
+
+// static
+base::android::FeatureMap* GetFeatureMap() {
+  static base::NoDestructor<base::android::FeatureMap> kFeatureMap(
+      kFeaturesExposedToJava);
+  return kFeatureMap.get();
+}
+
+} // namespace
+
+static jlong JNI_ChromeExtFeatureMap_GetNativeMap(JNIEnv* env) {
+  return reinterpret_cast<jlong>(GetFeatureMap());
+}
+
+} // namespace chrome::android
+
+DEFINE_JNI(ChromeExtFeatureMap)
