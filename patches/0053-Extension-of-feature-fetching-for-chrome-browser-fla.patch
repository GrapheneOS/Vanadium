diff --git a/vanadium/chromium_src/chrome/browser/flags/ext/android/java/src/org/chromium/chrome/browser/flags/ChromeExtFeatureList.java b/vanadium/chromium_src/chrome/browser/flags/ext/android/java/src/org/chromium/chrome/browser/flags/ChromeExtFeatureList.java
new file mode 100644
index 0000000000000..ed52b5011b98b
--- /dev/null
+++ b/vanadium/chromium_src/chrome/browser/flags/ext/android/java/src/org/chromium/chrome/browser/flags/ChromeExtFeatureList.java
@@ -0,0 +1,16 @@
+package org.chromium.chrome.browser.flags;
+
+import org.chromium.base.MutableFlagWithSafeDefault;
+import org.chromium.base.MutableIntParamWithSafeDefault;
+
