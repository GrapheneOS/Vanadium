diff --git a/vanadium/chromium_src/chrome/browser/flags/ext/android/java/src/org/chromium/chrome/browser/flags/ChromeExtFeatureMap.java b/vanadium/chromium_src/chrome/browser/flags/ext/android/java/src/org/chromium/chrome/browser/flags/ChromeExtFeatureMap.java
new file mode 100644
index 0000000000000..1173c73315d84
--- /dev/null
+++ b/vanadium/chromium_src/chrome/browser/flags/ext/android/java/src/org/chromium/chrome/browser/flags/ChromeExtFeatureMap.java
@@ -0,0 +1,42 @@
+package org.chromium.chrome.browser.flags;
+
+import org.jni_zero.JNINamespace;
+import org.jni_zero.NativeMethods;
+
+import org.chromium.base.FeatureMap;
+import org.chromium.base.Log;
+import org.chromium.build.annotations.NonNull;
+import org.chromium.build.annotations.NullMarked;
+
+@JNINamespace("chrome::android")
+@NullMarked
+public final class ChromeExtFeatureMap extends FeatureMap {
+
+    private static final String TAG = "ChromeExtFeatureMap";
+
+    @NonNull
+    private static final ChromeExtFeatureMap sInstance =
+            new ChromeExtFeatureMap();
+
+    private ChromeExtFeatureMap() {
+    }
+
+    @NonNull
+    public static ChromeExtFeatureMap getInstance() {
+        return sInstance;
+    }
+
+    public static boolean isEnabled(String featureName) {
+        return getInstance().isEnabledInNative(featureName);
+    }
+
+    @Override
+    protected long getNativeMap() {
+        return ChromeExtFeatureMapJni.get().getNativeMap();
+    }
+
+    @NativeMethods
+    public interface Natives {
+        long getNativeMap();
+    }
+}
