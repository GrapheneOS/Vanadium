From: quh4gko8 <88831734+quh4gko8@users.noreply.github.com>
Date: Tue, 13 Oct 2026 16:17:37 +0000
Subject: [PATCH] [bugfix] Fix chrome target generation when secondary ABI is
 disabled

---
 chrome/android/BUILD.gn | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/chrome/android/BUILD.gn b/chrome/android/BUILD.gn
index b8f2775c3a6a7..7e9935287ecbe 100644
--- a/chrome/android/BUILD.gn
+++ b/chrome/android/BUILD.gn
@@ -3587,5 +3587,7 @@ if (_is_default_toolchain &&
         "//android_webview:trichrome_webview_64_base_bundle_module_validate_android_manifest",
       ]
     }
+    # Can hardwire as only 64-bit builds enables assets verification.
+    deps -= filter_include(deps, ["*_32_*_validate_*",])
   }
 }
