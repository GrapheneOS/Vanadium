From: quh4gko8 <88831734+quh4gko8@users.noreply.github.com>
Date: Thu, 7 Dec 2023 08:29:57 +0000
Subject: [PATCH] Use ruleset from config apk whenever it's present

---
 .../content/browser/ruleset_service.cc                | 11 +++++++++++
 .../subresource_filter_android_cc_ext_deps.gni        |  2 ++
 2 files changed, 13 insertions(+)

diff --git a/components/subresource_filter/content/browser/ruleset_service.cc b/components/subresource_filter/content/browser/ruleset_service.cc
index 19bd5b85ba922..16d965bd153ce 100644
--- a/components/subresource_filter/content/browser/ruleset_service.cc
+++ b/components/subresource_filter/content/browser/ruleset_service.cc
@@ -43,6 +43,9 @@
 #include "content/public/browser/browser_thread.h"
 #include "content/public/browser/render_process_host.h"
 #include "third_party/protobuf/src/google/protobuf/io/zero_copy_stream_impl_lite.h"
+#if BUILDFLAG(IS_ANDROID)
+#include "vanadium/chromium_src/components/subresource_filter/ext/android/subresource_filter_fetching.h"
+#endif // BUILDFLAG(IS_ANDROID)
 
 namespace subresource_filter {
 
@@ -267,7 +270,12 @@ void RulesetService::IndexAndStoreAndPublishRulesetIfNeeded(
   if (most_recently_indexed_version.IsCurrentFormatVersion() &&
       most_recently_indexed_version.content_version ==
           unindexed_ruleset_info.content_version) {
+#if BUILDFLAG(IS_ANDROID)
+    if (!subresource_filter::IsInitializedFromConfig())
+      return;
+#else
     return;
+#endif // BUILDFLAG(IS_ANDROID)
   }
 
   // Before initialization, retain information about the most recently supplied
@@ -498,6 +506,9 @@ void RulesetService::OnWrittenRuleset(WriteRulesetCallback result_callback,
   }
   version.SaveToPrefs(local_state_);
   std::move(result_callback).Run(version);
+#if BUILDFLAG(IS_ANDROID)
+  subresource_filter::DeleteUnindexedFile();
+#endif // BUILDFLAG(IS_ANDROID)
 }
 
 void RulesetService::OpenAndPublishRuleset(
diff --git a/vanadium/chromium_src/components/subresource_filter/android/subresource_filter_android_cc_ext_deps.gni b/vanadium/chromium_src/components/subresource_filter/android/subresource_filter_android_cc_ext_deps.gni
index caaba54fdd505..6fc3a35f00eba 100644
--- a/vanadium/chromium_src/components/subresource_filter/android/subresource_filter_android_cc_ext_deps.gni
+++ b/vanadium/chromium_src/components/subresource_filter/android/subresource_filter_android_cc_ext_deps.gni
@@ -6,6 +6,8 @@
 # Three lines of code for minimizing conflicts in rebasing changes
 # Three lines of code for minimizing conflicts in rebasing changes
 subresource_filter_android_cc_ext_full_path_deps = [
+  "//vanadium/chromium_src/components/subresource_filter/ext/android:android",
+  "//vanadium/chromium_src/components/subresource_filter/ext/android:subresource_filter_fetching_jni_headers",
 ]
 # Three lines of code for minimizing conflicts in rebasing changes
