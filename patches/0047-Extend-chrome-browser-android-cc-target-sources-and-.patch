From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: quh4gko8 <88831734+quh4gko8@users.noreply.github.com>
Date: Fri, 29 Dec 2023 12:18:15 +0000
Subject: [PATCH] Extend //chrome/browser/android cc target sources and deps

---
 chrome/browser/android/BUILD.gn               |  5 ++++
 .../browser/android/android_cc_ext_deps.gni   | 26 +++++++++++++++++++
 .../android/android_cc_ext_sources.gni        | 26 +++++++++++++++++++
 3 files changed, 57 insertions(+)
 create mode 100644 vanadium/chromium_src/chrome/browser/android/android_cc_ext_deps.gni
 create mode 100644 vanadium/chromium_src/chrome/browser/android/android_cc_ext_sources.gni

diff --git a/chrome/browser/android/BUILD.gn b/chrome/browser/android/BUILD.gn
index a837a27dd574c..8609d134f104f 100644
--- a/chrome/browser/android/BUILD.gn
+++ b/chrome/browser/android/BUILD.gn
@@ -960,6 +960,11 @@ if (is_android) {
       "//chrome/browser/ui/startup:impl",
     ]
 
+    import("//vanadium/chromium_src/chrome/browser/android/android_cc_ext_sources.gni")
+    sources += android_cc_ext_sources
+    import("//vanadium/chromium_src/chrome/browser/android/android_cc_ext_deps.gni")
+    deps += android_cc_ext_deps
+
     if (dfmify_dev_ui) {
       deps += [
         "//chrome/browser/dev_ui",
diff --git a/vanadium/chromium_src/chrome/browser/android/android_cc_ext_deps.gni b/vanadium/chromium_src/chrome/browser/android/android_cc_ext_deps.gni
new file mode 100644
index 0000000000000..4b81e601d874a
--- /dev/null
+++ b/vanadium/chromium_src/chrome/browser/android/android_cc_ext_deps.gni
@@ -0,0 +1,26 @@
+# Copyright 2023-2026 GrapheneOS
+# Use of this source code is governed by a GPL-2.0-only style license that can be
+# found in the LICENSE file.
+
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+android_cc_ext_full_path_deps = [
+]
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+android_cc_ext_rel_path_deps = [
+]
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+android_cc_ext_deps = [
+]
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+android_cc_ext_deps += android_cc_ext_full_path_deps
+foreach(rel_path, android_cc_ext_rel_path_deps) {
+  android_cc_ext_deps += [ rebase_path(rel_path) ]
+}
diff --git a/vanadium/chromium_src/chrome/browser/android/android_cc_ext_sources.gni b/vanadium/chromium_src/chrome/browser/android/android_cc_ext_sources.gni
new file mode 100644
index 0000000000000..ab9052ddabc1f
--- /dev/null
+++ b/vanadium/chromium_src/chrome/browser/android/android_cc_ext_sources.gni
@@ -0,0 +1,26 @@
+# Copyright 2023-2026 GrapheneOS
+# Use of this source code is governed by a GPL-2.0-only style license that can be
+# found in the LICENSE file.
+
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+android_cc_ext_full_path_sources = [
+]
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+android_cc_ext_rel_path_sources = [
+]
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+android_cc_ext_sources = [
+]
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+# Three lines of code for minimizing conflicts in rebasing changes
+android_cc_ext_sources += android_cc_ext_full_path_sources
+foreach(rel_path, android_cc_ext_rel_path_sources) {
+  android_cc_ext_sources += [ rebase_path(rel_path) ]
+}
