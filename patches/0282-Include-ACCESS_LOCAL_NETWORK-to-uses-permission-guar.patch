From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: quh4gko8 <88831734+quh4gko8@users.noreply.github.com>
Date: Sun, 23 Aug 2026 12:48:54 +0000
Subject: [PATCH] Include ACCESS_LOCAL_NETWORK to uses-permission guarded by
 build flag

---
 chrome/android/chrome_public_apk_tmpl.gni                | 4 ++++
 chrome/android/java/AndroidManifest.xml                  | 5 +++++
 vanadium/chromium_src/chrome/android/chrome_ext_args.gni | 1 +
 3 files changed, 10 insertions(+)

diff --git a/chrome/android/chrome_public_apk_tmpl.gni b/chrome/android/chrome_public_apk_tmpl.gni
index 5e8368c29ba69..b27061ffcd5a2 100644
--- a/chrome/android/chrome_public_apk_tmpl.gni
+++ b/chrome/android/chrome_public_apk_tmpl.gni
@@ -248,6 +248,10 @@ template("chrome_common_apk_or_module_tmpl") {
     if (defined(invoker.jinja_extra_includes)) {
       includes += invoker.jinja_extra_includes
     }
+    import("//vanadium/chromium_src/chrome/android/chrome_ext_args.gni")
+    variables += [
+      "declare_access_local_network_permission=$declare_access_local_network_permission"
+    ]
   }
 
   target(_target_type, target_name) {
diff --git a/chrome/android/java/AndroidManifest.xml b/chrome/android/java/AndroidManifest.xml
index 886c7cca00437..335fac2a7bc63 100644
--- a/chrome/android/java/AndroidManifest.xml
+++ b/chrome/android/java/AndroidManifest.xml
@@ -133,6 +133,11 @@ by a child template that "extends" this file.
     {% if target_sdk_version >= 37 %}
     <!-- Needed for checking local network connections on Android 17+. -->
     <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK"/>
+    {% else %}
+    {% if (declare_access_local_network_permission|default('true')) == "true" %}
+    <!-- Needed for checking local network connections. -->
+    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK"/>
+    {% endif %}
     {% endif %}
 
     {% set enable_vr = enable_vr|default(0) %}
diff --git a/vanadium/chromium_src/chrome/android/chrome_ext_args.gni b/vanadium/chromium_src/chrome/android/chrome_ext_args.gni
index 34ce37bea69b4..4461d7a65fca8 100644
--- a/vanadium/chromium_src/chrome/android/chrome_ext_args.gni
+++ b/vanadium/chromium_src/chrome/android/chrome_ext_args.gni
@@ -4,4 +4,5 @@
 
 declare_args() {
   include_crashpad = false
+  declare_access_local_network_permission = true
 }
