From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: quh4gko8 <88831734+quh4gko8@users.noreply.github.com>
Date: Thu, 12 Dec 2024 07:09:40 +0000
Subject: [PATCH] Reduce user agent and client hints for webview

---
 android_webview/browser/aw_field_trials.cc                   | 4 ----
 android_webview/common/aw_features.cc                        | 2 +-
 .../webview/chromium/WebViewChromiumFactoryProvider.java     | 5 +----
 3 files changed, 2 insertions(+), 9 deletions(-)

diff --git a/android_webview/browser/aw_field_trials.cc b/android_webview/browser/aw_field_trials.cc
index 1fb25c218e551..4753dd87b1418 100644
--- a/android_webview/browser/aw_field_trials.cc
+++ b/android_webview/browser/aw_field_trials.cc
@@ -126,10 +126,6 @@ void AwFieldTrials::RegisterFeatureOverrides(base::FeatureList* feature_list) {
   // Disable launch_handler on WebView.
   aw_feature_overrides.DisableFeature(blink::features::kWebAppLaunchQueue);
 
-  // Disable Reducing User Agent minor version on WebView.
-  aw_feature_overrides.DisableFeature(
-      blink::features::kReduceUserAgentMinorVersion);
-
   // Disable fenced frames on WebView.
   aw_feature_overrides.DisableFeature(blink::features::kFencedFrames);
 
diff --git a/android_webview/common/aw_features.cc b/android_webview/common/aw_features.cc
index 1906fd59ac63c..dde0f24bde857 100644
--- a/android_webview/common/aw_features.cc
+++ b/android_webview/common/aw_features.cc
@@ -383,7 +383,7 @@ BASE_FEATURE(kWebViewReducedSeedRequestPeriod,
 
 // This enables reducing webview user-agent android version and device model.
 BASE_FEATURE(kWebViewReduceUAAndroidVersionDeviceModel,
-             base::FEATURE_DISABLED_BY_DEFAULT);
+             base::FEATURE_ENABLED_BY_DEFAULT);
 
 // When enabled, WebView support for Instant Apps is removed.
 BASE_FEATURE(kWebViewRemoveInstantAppSupport,
diff --git a/android_webview/glue/java/src/com/android/webview/chromium/WebViewChromiumFactoryProvider.java b/android_webview/glue/java/src/com/android/webview/chromium/WebViewChromiumFactoryProvider.java
index fe28018286b60..2fa89d0cf0730 100644
--- a/android_webview/glue/java/src/com/android/webview/chromium/WebViewChromiumFactoryProvider.java
+++ b/android_webview/glue/java/src/com/android/webview/chromium/WebViewChromiumFactoryProvider.java
@@ -1165,10 +1165,7 @@ public class WebViewChromiumFactoryProvider implements WebViewFactoryProvider {
                             ? targetSdkVersion < Build.VERSION_CODES.TIRAMISU
                             : !CompatChanges.isChangeEnabled(
                                     WebSettings.ENABLE_SIMPLIFIED_DARK_MODE);
-            case CompatQuirks.Quirk.FULL_USERAGENT ->
-                    Build.VERSION.SDK_INT < Build.VERSION_CODES.CINNAMON_BUN
-                            || !CompatChanges.isChangeEnabled(
-                                    WebSettings.ENABLE_USER_AGENT_REDUCTION);
+            case CompatQuirks.Quirk.FULL_USERAGENT -> false;
             case CompatQuirks.Quirk.DISABLE_FILESYSTEM_ACCESS_API ->
                     Build.VERSION.SDK_INT < Build.VERSION_CODES.CINNAMON_BUN
                             || !CompatChanges.isChangeEnabled(
