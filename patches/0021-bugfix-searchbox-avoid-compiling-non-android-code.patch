From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: quh4gko8 <88831734+quh4gko8@users.noreply.github.com>
Date: Sat, 9 May 2026 16:23:57 +0000
Subject: [PATCH] [bugfix] searchbox: avoid compiling non-android code

---
 .../ui/webui/cr_components/searchbox/searchbox_handler.cc   | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/chrome/browser/ui/webui/cr_components/searchbox/searchbox_handler.cc b/chrome/browser/ui/webui/cr_components/searchbox/searchbox_handler.cc
index 6e771163b7fe5..d62070d4526c2 100644
--- a/chrome/browser/ui/webui/cr_components/searchbox/searchbox_handler.cc
+++ b/chrome/browser/ui/webui/cr_components/searchbox/searchbox_handler.cc
@@ -227,6 +227,7 @@ constexpr char kShareIconResourceName[] =
     "//resources/cr_components/searchbox/icons/share_cr23.svg";
 #endif
 
+#if !BUILDFLAG(IS_ANDROID)
 std::u16string GetAdditionalA11yMessage(
     const AutocompleteMatch& match,
     searchbox::mojom::SelectionLineState state) {
@@ -264,6 +265,7 @@ bool MatchHasSideTypeAndRenderType(
          suggestion_groups_map.at(group_id).side_type() == side_type &&
          suggestion_groups_map.at(group_id).render_type() == render_type;
 }
+#endif // !BUILDFLAG(IS_ANDROID)
 
 std::string GetBase64UrlVariations(Profile* profile) {
   variations::VariationsClient* provider = profile->GetVariationsClient();
@@ -844,6 +846,9 @@ SearchboxHandler::CreateAutocompleteMatch(
     bookmarks::BookmarkModel* bookmark_model,
     const omnibox::GroupConfigMap& suggestion_groups_map,
     const TemplateURLService* turl_service) const {
+#if BUILDFLAG(IS_ANDROID)
+  return std::nullopt;
+#else // BUILDFLAG(IS_ANDROID)
   // Skip the primary column horizontal matches. This check guards against
   // this unexpected scenario as the UI expects the primary column matches to
   // be vertical ones.
@@ -999,6 +1004,7 @@ SearchboxHandler::CreateAutocompleteMatch(
   mojom_match->is_contextual_suggestion = match.IsContextualSearchSuggestion();
 
   return mojom_match;
+#endif // BUILDFLAG(IS_ANDROID)
 }
 
 WindowOpenDisposition SearchboxHandler::ComputeWindowOpenDisposition(
