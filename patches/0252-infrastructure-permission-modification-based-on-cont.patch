@@ -0,0 +1,34 @@
+package org.chromium.components.permissions;
+
+import org.chromium.build.annotations.NonNull;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+
+@NullMarked
+public class PermissionsControllerHooks {
+
+    private static final class LazyHolder {
+        @NonNull
+        private static final PermissionsControllerHooks INSTANCE =
+                new PermissionsControllerHooks();
+    }
+
+    @NonNull
+    static PermissionsControllerHooks getDefaultInstance() {
+        return LazyHolder.INSTANCE;
+    }
+
+    public final boolean isDefaultInstance() {
+        return getDefaultInstance() == this;
+    }
+
+    @Nullable
+    public Boolean treatAsAllowedPageInfoOverride() {
+        return null;
+    }
+
+    @Nullable
+    public String[] getRequiredPermissions() {
+        return null;
+    }
+}
diff --git a/components/permissions/android/downstream/java/src/org/chromium/components/permissions/PermissionsHooksRegistry.java b/components/permissions/android/downstream/java/src/org/chromium/components/permissions/PermissionsHooksRegistry.java
new file mode 100644
index 0000000000000..2355c73e1c98c
--- /dev/null
+++ b/components/permissions/android/downstream/java/src/org/chromium/components/permissions/PermissionsHooksRegistry.java
@@ -0,0 +1,13 @@
+package org.chromium.components.permissions;
+
+import org.chromium.components.content_settings.ContentSettingsType;
+
+public final class PermissionsHooksRegistry {
+
+    public static PermissionsControllerHooks getPermissionsControllerHooks(
+            @ContentSettingsType.EnumType int contentSettingsType) {
+        return switch (contentSettingsType) {
+            default -> PermissionsControllerHooks.getDefaultInstance();
+        };
+    }
+}
diff --git a/components/permissions/android/java/src/org/chromium/components/permissions/PermissionUtil.java b/components/permissions/android/java/src/org/chromium/components/permissions/PermissionUtil.java
