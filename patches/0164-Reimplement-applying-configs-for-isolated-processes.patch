diff --git a/vanadium/content/app/android/java/src/app/vanadium/content/app/ConfigChildProcessConnection.java b/vanadium/content/app/android/java/src/app/vanadium/content/app/ConfigChildProcessConnection.java
new file mode 100644
index 0000000000000..3fbc1a2658dba
--- /dev/null
+++ b/vanadium/content/app/android/java/src/app/vanadium/content/app/ConfigChildProcessConnection.java
@@ -0,0 +1,24 @@
+package app.vanadium.content.app;
+
+import android.content.ComponentName;
+import android.content.ServiceConnection;
+import android.os.IBinder;
+
+final class ConfigChildProcessConnection implements ServiceConnection {
+
+    private final ConfigChildProcessLauncher.Delegate mDelegate;
+
+    ConfigChildProcessConnection(ConfigChildProcessLauncher.Delegate delegate) {
+        mDelegate = delegate;
+    }
+
+    @Override
+    public void onServiceConnected(ComponentName name, IBinder service) {
+        mDelegate.onServiceConnected(service);
+    }
+
+    @Override
+    public void onServiceDisconnected(ComponentName name) {
+        mDelegate.onServiceDisconnected();
+    }
+}
diff --git a/vanadium/content/app/android/java/src/app/vanadium/content/app/ConfigChildProcessLauncher.java b/vanadium/content/app/android/java/src/app/vanadium/content/app/ConfigChildProcessLauncher.java
new file mode 100644
index 0000000000000..0e83c9b8a246f
--- /dev/null
+++ b/vanadium/content/app/android/java/src/app/vanadium/content/app/ConfigChildProcessLauncher.java
@@ -0,0 +1,58 @@
+package app.vanadium.content.app;
+
+import android.content.Context;
+import android.content.Intent;
+import android.os.IBinder;
+
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+
+public final class ConfigChildProcessLauncher {
+
+    public interface Delegate {
+        void onServiceConnected(IBinder service);
+        void onServiceDisconnected();
+    }
+
+    private final ExecutorService mLauncherExecutor;
+    private final ConfigChildProcessConnection mServiceConnection;
+    private final ConfigChildProcessParams mParams;
+
+    public static ConfigChildProcessLauncher create(
+            ConfigChildProcessParams params, Delegate delegate) {
+        return new ConfigChildProcessLauncher(params, delegate);
+    }
+
+    private ConfigChildProcessLauncher(
+            ConfigChildProcessParams params, Delegate delegate) {
+        mLauncherExecutor = Executors.newSingleThreadExecutor();
+        mServiceConnection = new ConfigChildProcessConnection(new Delegate() {
+            @Override
+            public void onServiceConnected(IBinder service) {
+                mLauncherExecutor.execute(() -> delegate.onServiceConnected(service));
+            }
+
+            @Override
+            public void onServiceDisconnected() {
+                mLauncherExecutor.execute(() -> delegate.onServiceDisconnected());
+            }
+        });
+        mParams = params;
+    }
+
+    public void bind(Context appCtx) {
+        Intent intent = new Intent();
+        intent.setPackage(mParams.getServicePkgName());
+        intent.setClassName(mParams.getServicePkgName(), mParams.getServiceClassName());
+        int bindFlags = Context.BIND_AUTO_CREATE;
+        if (mParams.bindExternalService()) {
+            bindFlags |= Context.BIND_EXTERNAL_SERVICE;
+        }
+        appCtx.bindIsolatedService(intent, bindFlags, "0",
+                mLauncherExecutor, mServiceConnection);
+    }
+
+    public void unbind(Context appCtx) {
+        appCtx.unbindService(mServiceConnection);
+    }
+}
diff --git a/vanadium/content/app/android/java/src/app/vanadium/content/app/ConfigChildProcessParams.java b/vanadium/content/app/android/java/src/app/vanadium/content/app/ConfigChildProcessParams.java
new file mode 100644
index 0000000000000..9837d79e22ea0
--- /dev/null
+++ b/vanadium/content/app/android/java/src/app/vanadium/content/app/ConfigChildProcessParams.java
@@ -0,0 +1,25 @@
+package app.vanadium.content.app;
+
+public class ConfigChildProcessParams {
+
+    private final String mPackageName;
+    private final boolean mBindAsExternalService;
+
+    public ConfigChildProcessParams(
+            String packageName, boolean bindAsExternalService) {
+        this.mPackageName = packageName;
+        this.mBindAsExternalService = bindAsExternalService;
+    }
+
+    String getServicePkgName() {
+        return mPackageName;
+    }
+
+    String getServiceClassName() {
+        return "app.vanadium.content.app.ConfigSandboxedProcessService";
+    }
+
+    boolean bindExternalService() {
+        return mBindAsExternalService;
+    }
+}
