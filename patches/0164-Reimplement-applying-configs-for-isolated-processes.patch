@@ -0,0 +1,23 @@
+package app.vanadium.content.app;
+
+import android.app.Service;
+import android.content.Intent;
+import android.os.IBinder;
+
+import app.vanadium.ext.CustomOSApis;
+
+public final class ConfigSandboxedProcessService extends Service {
+
+    private final IConfigSandboxedProcessService.Stub mBinder =
+            new IConfigSandboxedProcessService.Stub() {
+                @Override
+                public boolean isExecmemBlocked() {
+                    return CustomOSApis.isExecmemBlocked();
+                }
+    };
+
+    @Override
+    public IBinder onBind(Intent intent) {
+        return mBinder;
+    }
+}
