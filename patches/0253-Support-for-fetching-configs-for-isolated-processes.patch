+package org.chromium.base.config;
+
+import android.content.Context;
+import android.os.IBinder;
+import android.os.RemoteException;
+import android.util.Log;
+
+import org.chromium.base.command_line.VanadiumCommandLineUtils;
+import org.chromium.base.library_loader.LibraryProcessType;
+import org.chromium.build.annotations.NonNull;
+
+import app.vanadium.config.VanadiumConfParser;
+import app.vanadium.content.app.ConfigChildProcessLauncher;
+import app.vanadium.content.app.ConfigChildProcessParams;
+import app.vanadium.content.app.IConfigSandboxedProcessService;
+
+import static app.vanadium.config.proto.VanadiumConfigProto.Flag.FlagType.DISABLED_FEATURE;
+
+public class ConfigsFromSandboxedService {
+
+    private static final String TAG = "ConfigsFromSandboxedService";
+
+    private static boolean isDisabled() {
+        String featureKey = "CheckOsConfigsForIsolatedProcessV2";
+        if (VanadiumConfParser.getFlagsFor(DISABLED_FEATURE).containsKey(featureKey)) {
+            return true;
+        }
+
+        return false;
+    }
+
+    public static void init(@NonNull Context appContext, @LibraryProcessType int type) {
+        switch (type) {
+            case LibraryProcessType.PROCESS_BROWSER,
+                 LibraryProcessType.PROCESS_WEBVIEW,
+                 LibraryProcessType.PROCESS_WEBVIEW_NONEMBEDDED -> {
+            }
+            case LibraryProcessType.PROCESS_CHILD,
+                 LibraryProcessType.PROCESS_WEBVIEW_CHILD -> {
+                return;
+            }
+            default -> throw new IllegalArgumentException("Invalid library process type");
+        }
+
+        if (isDisabled()) {
+            Log.i(TAG, "Not initializing configs fetching from sandboxed service");
+            return;
+        }
+
+        ConfigChildProcessParams params = getConfigChildProcessParams(appContext, type);
+        ConfigChildProcessLauncher launcher =
+                ConfigChildProcessLauncher.create(params, getDelegateInstance());
+        launcher.bind(appContext);
+    }
+
+    @NonNull
+    private static ConfigChildProcessParams getConfigChildProcessParams(
+            @NonNull Context appContext, @LibraryProcessType int type) {
+        final boolean bindAsExternalService = type == LibraryProcessType.PROCESS_WEBVIEW;
+        if (bindAsExternalService) {
+            if (!sServicePkgNameSet) {
+                throw new IllegalStateException("Need to set service package name");
+            }
+        }
+
+        final String servicePkgName = sServicePkgName != null ? sServicePkgName
+                                                              : appContext.getPackageName();
+        return new ConfigChildProcessParams(
+                servicePkgName, bindAsExternalService);
+    }
+
+    private static String sServicePkgName;
+    private static volatile boolean sServicePkgNameSet;
+
+    public static void setServicePackageName(@NonNull String servicePackageName) {
+        if (isDisabled()) {
+            Log.i(TAG, "Not setting package name for sandboxed service fetching configs");
+            return;
+        }
+
+        sServicePkgName = servicePackageName;
+        sServicePkgNameSet = true;
+    }
+
+    private static final class LauncherDelegateInner implements ConfigChildProcessLauncher.Delegate {
+
+        private static final LauncherDelegateInner INSTANCE =
+                new LauncherDelegateInner();
+
+        private IConfigSandboxedProcessService mService;
+        private volatile boolean mServiceConnected;
+
+        @Override
+        public void onServiceConnected(IBinder service) {
+            mService = IConfigSandboxedProcessService.Stub.asInterface(service);
+            mServiceConnected = true;
+        }
+
+        @Override
+        public void onServiceDisconnected() {
+            mService = null;
+            mServiceConnected = false;
+        }
+
+        private boolean isServiceConnected() {
+            return mServiceConnected;
+        }
+
+        private boolean isExecmemBlocked() {
+            try {
+                return mService.isExecmemBlocked();
+            } catch (RemoteException e) {
+                Log.e(TAG, "", e);
+                return false;
+            }
+        }
+    }
+
+    private static ConfigChildProcessLauncher.Delegate getDelegateInstance() {
+        return LauncherDelegateInner.INSTANCE;
+    }
+
+    private static LauncherDelegateInner getDelegateInner() {
+        return LauncherDelegateInner.INSTANCE;
+    }
+
+    public static boolean isServiceConnected() {
+        if (isDisabled()) {
+            Log.i(TAG, "Disabled fetching configs from sandboxed service");
+            return false;
+        }
+
+        return getDelegateInner().isServiceConnected();
+    }
+
+    public static boolean isExecmemBlocked() {
+        if (isDisabled()) {
+            Log.i(TAG, "Disabled fetching config for execmem if blocked from sandboxed service");
+            return false;
+        }
+
+        return getDelegateInner().isExecmemBlocked();
+    }
+}
