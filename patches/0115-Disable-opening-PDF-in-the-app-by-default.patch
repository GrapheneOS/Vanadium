From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: quh4gko8 <88831734+quh4gko8@users.noreply.github.com>
Date: Sun, 1 Jun 2025 15:36:35 +0000
Subject: [PATCH] Disable opening PDF in the app by default

---
 .../customtabs/CustomTabAppMenuPropertiesDelegate.java    | 6 ++++--
 .../CustomTabAppMenuPropertiesDelegateUnitTest.java       | 5 +++++
 .../src/org/chromium/chrome/browser/pdf/PdfUtils.java     | 4 ++++
 .../browser/ui/android/pdf/pdf_utils_java_ext_deps.gni    | 1 +
 .../chromium_src/content/public/ext/android/features.cc   | 4 ++++
 .../chromium_src/content/public/ext/android/features.h    | 1 +
 .../chromium/content_public/ContentExtFeatureList.java    | 8 ++++++++
 7 files changed, 27 insertions(+), 2 deletions(-)

diff --git a/chrome/android/java/src/org/chromium/chrome/browser/customtabs/CustomTabAppMenuPropertiesDelegate.java b/chrome/android/java/src/org/chromium/chrome/browser/customtabs/CustomTabAppMenuPropertiesDelegate.java
index ad6ebaa55280e..f7b194ae03f11 100644
--- a/chrome/android/java/src/org/chromium/chrome/browser/customtabs/CustomTabAppMenuPropertiesDelegate.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/customtabs/CustomTabAppMenuPropertiesDelegate.java
@@ -251,8 +251,10 @@ public class CustomTabAppMenuPropertiesDelegate extends AppMenuPropertiesDelegat
         boolean isContentScheme = url.getScheme().equals(UrlConstants.CONTENT_SCHEME);
         // TODO(crbug.com/384992232): Hide open in Chrome for blob and data url until such view
         //  intent can be handled.
-        if (url.getScheme().equals(UrlConstants.BLOB_SCHEME)
-                || url.getScheme().equals(UrlConstants.DATA_SCHEME)) {
+        if (org.chromium.content_public.ContentExtFeatureList
+                .sAndroidOpenPdfInline.isEnabled()
+                && (url.getScheme().equals(UrlConstants.BLOB_SCHEME)
+                        || url.getScheme().equals(UrlConstants.DATA_SCHEME))) {
             openInChromeItemVisible = false;
         }
         addToHomeScreenVisible &=
diff --git a/chrome/android/junit/src/org/chromium/chrome/browser/customtabs/CustomTabAppMenuPropertiesDelegateUnitTest.java b/chrome/android/junit/src/org/chromium/chrome/browser/customtabs/CustomTabAppMenuPropertiesDelegateUnitTest.java
index 719beb40af849..c7fee31d8031d 100644
--- a/chrome/android/junit/src/org/chromium/chrome/browser/customtabs/CustomTabAppMenuPropertiesDelegateUnitTest.java
+++ b/chrome/android/junit/src/org/chromium/chrome/browser/customtabs/CustomTabAppMenuPropertiesDelegateUnitTest.java
@@ -32,6 +32,7 @@ import org.chromium.base.ContextUtils;
 import org.chromium.base.supplier.ObservableSuppliers;
 import org.chromium.base.supplier.SettableMonotonicObservableSupplier;
 import org.chromium.base.test.BaseRobolectricTestRunner;
+import org.chromium.base.test.util.Features.DisableFeatures;
 import org.chromium.base.test.util.Features.EnableFeatures;
 import org.chromium.chrome.R;
 import org.chromium.chrome.browser.ActivityTabProvider;
@@ -58,6 +59,7 @@ import org.chromium.components.commerce.core.CommerceFeatureUtilsJni;
 import org.chromium.components.commerce.core.ShoppingService;
 import org.chromium.components.power_bookmarks.PowerBookmarkMeta;
 import org.chromium.components.power_bookmarks.ShoppingSpecifics;
+import org.chromium.content_public.ContentExtFeatures;
 import org.chromium.content_public.browser.NavigationController;
 import org.chromium.content_public.browser.WebContents;
 import org.chromium.ui.modelutil.MVCListAdapter;
@@ -67,6 +69,9 @@ import java.util.ArrayList;
 
 /** Unit tests for {@link CustomTabAppMenuPropertiesDelegate}. */
 @RunWith(BaseRobolectricTestRunner.class)
+@DisableFeatures({
+    ContentExtFeatures.ANDROID_OPEN_PDF_INLINE,
+})
 public class CustomTabAppMenuPropertiesDelegateUnitTest {
     @Rule public final MockitoRule mMockitoRule = MockitoJUnit.rule();
     @Mock private Tab mTab;
diff --git a/chrome/browser/ui/android/pdf/java/src/org/chromium/chrome/browser/pdf/PdfUtils.java b/chrome/browser/ui/android/pdf/java/src/org/chromium/chrome/browser/pdf/PdfUtils.java
index 27872af6fd14b..ec89a036c81de 100644
--- a/chrome/browser/ui/android/pdf/java/src/org/chromium/chrome/browser/pdf/PdfUtils.java
+++ b/chrome/browser/ui/android/pdf/java/src/org/chromium/chrome/browser/pdf/PdfUtils.java
@@ -146,6 +146,10 @@ public class PdfUtils {
     }
 
     private static boolean isPlatformSupported() {
+            if (!org.chromium.content_public.ContentExtFeatureList
+                    .sAndroidOpenPdfInline.isEnabled()) {
+                return false;
+            }
         if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.VANILLA_ICE_CREAM) {
             return true;
         }
diff --git a/vanadium/chromium_src/chrome/browser/ui/android/pdf/pdf_utils_java_ext_deps.gni b/vanadium/chromium_src/chrome/browser/ui/android/pdf/pdf_utils_java_ext_deps.gni
index 1681773c2d484..eb7f4dfeee78b 100644
--- a/vanadium/chromium_src/chrome/browser/ui/android/pdf/pdf_utils_java_ext_deps.gni
+++ b/vanadium/chromium_src/chrome/browser/ui/android/pdf/pdf_utils_java_ext_deps.gni
@@ -6,6 +6,7 @@
 # Three lines of code for minimizing conflicts in rebasing changes
 # Three lines of code for minimizing conflicts in rebasing changes
 pdf_utils_java_ext_full_path_deps = [
+  "//vanadium/chromium_src/content/public/ext/android:feature_map_java",
 ]
 # Three lines of code for minimizing conflicts in rebasing changes
 # Three lines of code for minimizing conflicts in rebasing changes
diff --git a/vanadium/chromium_src/content/public/ext/android/features.cc b/vanadium/chromium_src/content/public/ext/android/features.cc
index 27f3fba8875c0..8235cd236bb82 100644
--- a/vanadium/chromium_src/content/public/ext/android/features.cc
+++ b/vanadium/chromium_src/content/public/ext/android/features.cc
@@ -10,9 +10,13 @@
 
 namespace content::android {
 
+// Enable open PDF inline on Android.
+BASE_FEATURE(kAndroidOpenPdfInline, base::FEATURE_DISABLED_BY_DEFAULT);
+
 namespace {
 
 const base::Feature* const kFeaturesExposedToJava[] = {
+  &kAndroidOpenPdfInline,
 };
 
 // static
diff --git a/vanadium/chromium_src/content/public/ext/android/features.h b/vanadium/chromium_src/content/public/ext/android/features.h
index 3e828daf29e15..14b6acb6b834c 100644
--- a/vanadium/chromium_src/content/public/ext/android/features.h
+++ b/vanadium/chromium_src/content/public/ext/android/features.h
@@ -8,6 +8,7 @@
 
 namespace content::android {
 
+BASE_DECLARE_FEATURE(kAndroidOpenPdfInline);
 } // namespace content::android
 
 #endif // CONTENT_PUBLIC_EXT_ANDROID_FEATURES_H_
diff --git a/vanadium/chromium_src/content/public/ext/android/java/src/org/chromium/content_public/ContentExtFeatureList.java b/vanadium/chromium_src/content/public/ext/android/java/src/org/chromium/content_public/ContentExtFeatureList.java
index f21210bd5f0b8..faa0ef30a4bd1 100644
--- a/vanadium/chromium_src/content/public/ext/android/java/src/org/chromium/content_public/ContentExtFeatureList.java
+++ b/vanadium/chromium_src/content/public/ext/android/java/src/org/chromium/content_public/ContentExtFeatureList.java
@@ -11,6 +11,14 @@ public final class ContentExtFeatureList {
 
     private static final String TAG = "ContentExtFeatureList";
 
+    @NonNull
+    public static final MutableFlagWithSafeDefault sAndroidOpenPdfInline =
+            new MutableFlagWithSafeDefault(
+                    ContentExtFeatureMap.getInstance(),
+                    ContentExtFeatures.ANDROID_OPEN_PDF_INLINE,
+                    false
+            );
+
     private ContentExtFeatureList() {
     }
 }
