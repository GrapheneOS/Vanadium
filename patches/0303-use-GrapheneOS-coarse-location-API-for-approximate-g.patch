diff --git a/services/device/geolocation/android/java/src/org/chromium/device/geolocation/LocationProviderAndroid.java b/services/device/geolocation/android/java/src/org/chromium/device/geolocation/LocationProviderAndroid.java
index 8acca131c6584..ac8787500c5e0 100644
--- a/services/device/geolocation/android/java/src/org/chromium/device/geolocation/LocationProviderAndroid.java
+++ b/services/device/geolocation/android/java/src/org/chromium/device/geolocation/LocationProviderAndroid.java
@@ -62,11 +62,14 @@ public class LocationProviderAndroid implements LocationProvider {
         // approximate (coarse) location using Criteria. To avoid leaking precise location
         // when coarse location is requested, report a position error.
         // See crbug.com/502587667.
+        // GrapheneOS provides an API for requesting coarse locations when precise location
+        // permission is granted, see requestCoarseLocationUpdates().
         if (PermissionsAndroidFeatureMap.isEnabled(
                         PermissionsAndroidFeatureList.APPROXIMATE_GEOLOCATION_PERMISSION)
                 && !enableHighAccuracy
                 && mContext.checkCallingOrSelfPermission(Manifest.permission.ACCESS_FINE_LOCATION)
-                        == PackageManager.PERMISSION_GRANTED) {
+                        == PackageManager.PERMISSION_GRANTED
+                && !CoarseLocationRequests.isSupported()) {
             unregisterFromLocationUpdates();
             LocationProviderAdapter.newErrorAvailable("Cannot generate approximate location.");
             return;
@@ -174,6 +177,9 @@ public class LocationProviderAndroid implements LocationProvider {
                     criteria.setAccuracy(Criteria.ACCURACY_FINE);
                 } else {
                     criteria.setAccuracy(Criteria.ACCURACY_COARSE);
+                    if (requestCoarseLocationUpdates()) {
+                        return;
+                    }
                 }
             } else {
                 if (mEffectiveHighAccuracy) {
@@ -200,6 +206,26 @@ public class LocationProviderAndroid implements LocationProvider {
         }
     }
 
+    /**
+     * Requests coarse locations via the GrapheneOS API, see CoarseLocationRequests.
+     *
+     * @return true if the request was handled, false if the Criteria-based request should be used.
+     */
+    @RequiresNonNull({"mLocationManager", "mLocationListener"})
+    private boolean requestCoarseLocationUpdates() {
+        if (CoarseLocationRequests.requestLocationUpdates(mLocationManager, mLocationListener)) {
+            return true;
+        }
+        if (mContext.checkCallingOrSelfPermission(Manifest.permission.ACCESS_FINE_LOCATION)
+                == PackageManager.PERMISSION_GRANTED) {
+            // Criteria-based request would deliver precise locations, see start().
+            unregisterFromLocationUpdates();
+            LocationProviderAdapter.newErrorAvailable("Cannot generate approximate location.");
+            return true;
+        }
+        return false;
+    }
+
     /** Unregisters this object from the location service. */
     private void unregisterFromLocationUpdates() {
         if (!mIsRunning) return;
