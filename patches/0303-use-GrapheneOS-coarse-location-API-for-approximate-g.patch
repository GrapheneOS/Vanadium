diff --git a/vanadium/chromium_src/services/downstream/device/geolocation/android/java/src/org/chromium/device/geolocation/CoarseLocationRequests.java b/vanadium/chromium_src/services/downstream/device/geolocation/android/java/src/org/chromium/device/geolocation/CoarseLocationRequests.java
new file mode 100644
index 0000000000000..49265ef209ba8
--- /dev/null
+++ b/vanadium/chromium_src/services/downstream/device/geolocation/android/java/src/org/chromium/device/geolocation/CoarseLocationRequests.java
@@ -0,0 +1,46 @@
+package org.chromium.device.geolocation;
+
+import android.location.LocationListener;
+import android.location.LocationManager;
+import android.location.LocationRequest;
+
+import org.chromium.base.ThreadUtils;
+import org.chromium.build.annotations.NullMarked;
+
+import app.vanadium.ext.CustomOSApis;
+
+/**
+ * Requests coarse locations via the GrapheneOS LocationRequest.Builder#setCoarse() API.
+ */
+@NullMarked
+final class CoarseLocationRequests {
+    private CoarseLocationRequests() {}
+
+    static boolean isSupported() {
+        return CustomOSApis.isCoarseLocationRequestSupported();
+    }
+
+    /**
+     * Requests coarse location updates from the fused provider with the same parameters as the
+     * Criteria-based request made for Criteria.ACCURACY_COARSE.
+     *
+     * @return false if requesting coarse locations isn't supported or failed, in which case no
+     *     request was made.
+     */
+    static boolean requestLocationUpdates(
+            LocationManager locationManager, LocationListener listener) {
+        LocationRequest.Builder builder =
+                new LocationRequest.Builder(0)
+                        .setQuality(LocationRequest.QUALITY_BALANCED_POWER_ACCURACY)
+                        .setMinUpdateIntervalMillis(0);
+        if (!CustomOSApis.setLocationRequestCoarse(builder)) {
+            return false;
+        }
+        locationManager.requestLocationUpdates(
+                LocationManager.FUSED_PROVIDER,
+                builder.build(),
+                ThreadUtils.getUiThreadHandler()::post,
+                listener);
+        return true;
+    }
+}
diff --git a/vanadium/ext/custom_os/java/src/app/vanadium/ext/CustomOSApis.java b/vanadium/ext/custom_os/java/src/app/vanadium/ext/CustomOSApis.java
index 1cec7d175632b..79e308cd9af68 100644
--- a/vanadium/ext/custom_os/java/src/app/vanadium/ext/CustomOSApis.java
+++ b/vanadium/ext/custom_os/java/src/app/vanadium/ext/CustomOSApis.java
@@ -1,5 +1,6 @@
 package app.vanadium.ext;
 
+import android.location.LocationRequest;
 import android.os.Environment;
 import android.util.Log;
 
@@ -107,4 +108,48 @@ public class CustomOSApis {
     public static Boolean isWebViewDclRestricted() {
         return sIsWebViewDclRestrictedMethodCacheWrapper.invoke(null);
     }
+
+    private static final MemberCache<Method> sLocationRequestBuilderSetCoarseMethodCache =
+            MemberCache.of(new MemberCache.Fetcher<>() {
+
+                @Override
+                public Method getMember() throws NoSuchMethodException {
+                    return LocationRequest.Builder.class.getDeclaredMethod(
+                            "setCoarse", Boolean.TYPE);
+                }
+
+                @Override
+                public void logOrThrow(ReflectiveOperationException e) {
+                    Log.e(TAG, "", e);
+                }
+            });
+
+    /**
+     * Checks if the OS supports location requests that are limited to coarse locations even when
+     * the app holds the ACCESS_FINE_LOCATION permission, see {@link #setLocationRequestCoarse}.
+     */
+    public static boolean isCoarseLocationRequestSupported() {
+        return sLocationRequestBuilderSetCoarseMethodCache.getMember() != null;
+    }
+
+    /**
+     * Limits location requests built by the given builder to coarse locations. The OS coarsens
+     * locations that are delivered for such requests even when the app holds the
+     * ACCESS_FINE_LOCATION permission.
+     * @return true if the OS method exists and was invoked successfully, false otherwise.
+     */
+    public static boolean setLocationRequestCoarse(LocationRequest.Builder builder) {
+        Method method = sLocationRequestBuilderSetCoarseMethodCache.getMember();
+        if (method == null) {
+            return false;
+        }
+
+        try {
+            method.invoke(builder, true);
+            return true;
+        } catch (InvocationTargetException | IllegalAccessException e) {
+            Log.e(TAG, "", e);
+            return false;
+        }
+    }
 }
